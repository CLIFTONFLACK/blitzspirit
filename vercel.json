{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "comment": [
    "Redirects only. This project publishes the repo as-is - no build step, no",
    "output directory - which is the arrangement that actually works here.",
    "",
    "The shop's built HTML is therefore committed at the repo root by",
    "tools/publish.mjs, and rebuilt by .github/workflows/build-shop.yml whenever",
    "standalone/ changes. Generated files sitting beside source is the cost of",
    "needing no Vercel configuration.",
    "",
    "The redirects keep every URL that was ever live working - including the",
    "/new/assets/... the committed /social page still asks for, since it was",
    "generated while the shop lived under /new/."
  ],
  "redirects": [
    {
      "source": "/new",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/new/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/collection.html",
      "destination": "/old/collection.html",
      "permanent": true
    },
    {
      "source": "/heritage.html",
      "destination": "/old/heritage.html",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/old/admin.html",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/old/about.html",
      "permanent": true
    },
    {
      "source": "/help.html",
      "destination": "/old/help.html",
      "permanent": true
    },
    {
      "source": "/icons.html",
      "destination": "/old/icons.html",
      "permanent": true
    },
    {
      "source": "/story.html",
      "destination": "/old/story.html",
      "permanent": true
    },
    {
      "source": "/product.html",
      "destination": "/old/product.html",
      "permanent": true
    },
    {
      "source": "/product-cap.html",
      "destination": "/old/product-cap.html",
      "permanent": true
    },
    {
      "source": "/product-establishment.html",
      "destination": "/old/product-establishment.html",
      "permanent": true
    },
    {
      "source": "/product-roll-call.html",
      "destination": "/old/product-roll-call.html",
      "permanent": true
    },
    {
      "source": "/product-roundel.html",
      "destination": "/old/product-roundel.html",
      "permanent": true
    },
    {
      "source": "/product-skull.html",
      "destination": "/old/product-skull.html",
      "permanent": true
    },
    {
      "source": "/light/:path*",
      "destination": "/old/light/:path*",
      "permanent": true
    },
    {
      "source": "/newui.css",
      "destination": "/old/newui.css",
      "permanent": true
    },
    {
      "source": "/styles.css",
      "destination": "/old/styles.css",
      "permanent": true
    },
    {
      "source": "/main.js",
      "destination": "/old/main.js",
      "permanent": true
    }
  ]
}
