{% comment %}
  main-product — the ISSUE_001 PDP (Workstream B).

  Layout (ported from product.html / product-cap.html):
    breadcrumb → 50/50 grid: LEFT sticky gallery (ref tag, plate frames,
    thumbnails) / RIGHT ledger built from ordered blocks.

  <product-form> contract (docs/CONTRACTS.md §4):
    - input[name="id"], option buttons [data-option-index][data-value]
      with aria-pressed, script[data-variant-json], add button
      .directive[name="add"], [data-price], [data-stock], [data-plate].
    - Money is NEVER formatted in JS: every variant's price is
      pre-rendered server-side in a hidden span keyed by
      data-variant-price="<variant id>" inside the [data-price]
      container; product-form.js only toggles [hidden].
    - The plate swap uses the same pattern: one plate frame per image
      media ([data-plate-frame][data-media-id][data-image-id]),
      toggled via [hidden] so srcset/width/height survive.
    - data-product-wrap on the section root is the JS lookup scope.
    - No-JS: the form posts natively; a <noscript> variant <select>
      overrides the hidden id input (last field wins).
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign issue_val = product.metafields.custom.issue | default: 'ISSUE_001'
  assign index_ref = product.metafields.custom.index_ref
  assign crumb_collection = collection | default: product.collections.first

  comment
    index_ref values like "#01" become "ENTRY 01" (kicker) and "01 OF NN"
    (archive note); any other value is shown verbatim.
  endcomment
  assign entry_num = ''
  if index_ref != blank
    assign ref_first = index_ref | slice: 0, 1
    if ref_first == '#'
      assign entry_num = index_ref | remove: '#'
    endif
  endif

  assign current_media_id = current_variant.featured_media.id | default: product.featured_media.id

  assign image_media_count = 0
  for media in product.media
    if media.media_type == 'image'
      assign image_media_count = image_media_count | plus: 1
    endif
  endfor
-%}

<section class="pdp-wrap" data-product-wrap data-section-id="{{ section.id }}">

  {%- if section.settings.show_breadcrumb -%}
    <nav class="pdp-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="tag">[ {{ shop.name | upcase | escape }} ]</a>
      <span class="tag sep" aria-hidden="true">//</span>
      {%- if crumb_collection != blank -%}
        <a href="{{ crumb_collection.url }}" class="tag">[ {{ crumb_collection.title | upcase | escape }} ]</a>
        <span class="tag sep" aria-hidden="true">//</span>
      {%- endif -%}
      <span class="tag crumb-current" aria-current="page">[ {{ product.title | upcase | escape }} ]</span>
    </nav>
  {%- endif -%}

  <div class="pdp">

    <div class="pdp-gallery">
      <div class="pdp-gallery-row">
        {%- if image_media_count > 1 -%}
          <div class="pdp-thumbs">
            {%- for media in product.media -%}
              {%- if media.media_type == 'image' -%}
                <button
                  type="button"
                  class="pdp-thumb snap"
                  data-thumb
                  data-media-id="{{ media.id }}"
                  data-image-id="{{ media.preview_image.id }}"
                  aria-pressed="{% if media.id == current_media_id %}true{% else %}false{% endif %}"
                  aria-label="{{ media.preview_image.alt | default: product.title | escape }}"
                >
                  <img
                    src="{{ media.preview_image | image_url: width: 144 }}"
                    alt=""
                    width="144"
                    height="{{ 144 | divided_by: media.preview_image.aspect_ratio | round }}"
                    loading="lazy"
                  >
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="pdp-gallery-main">
          {%- if image_media_count > 0 -%}
            {%- for media in product.media -%}
              {%- if media.media_type == 'image' -%}
                {%- assign is_current = false -%}
                {%- if media.id == current_media_id -%}
                  {%- assign is_current = true -%}
                {%- endif -%}
                <div
                  data-plate-frame
                  data-media-id="{{ media.id }}"
                  data-image-id="{{ media.preview_image.id }}"
                  {% unless is_current %}hidden{% endunless %}
                >
                  {%- if is_current -%}
                    {% render 'plate', image: media.preview_image, alt: product.title, priority: true, sizes: '(min-width: 860px) 36vw, 80vw' %}
                  {%- else -%}
                    {% render 'plate', image: media.preview_image, alt: product.title, sizes: '(min-width: 860px) 36vw, 80vw' %}
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <div data-plate-frame>
              {% render 'plate', alt: product.title %}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="pdp-ledger">
      <product-form data-section-id="{{ section.id }}" data-url-update>
        {%- assign fold_stock_into_price = false -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when '@app' -%}
              {% render block %}

            {%- when 'issue_tag' -%}
              <div class="pdp-issue" {{ block.shopify_attributes }}>
                <div class="pdp-kicker tag tag-mute">
                  {{- issue_val | upcase -}}
                  {%- if entry_num != blank %} &middot; ENTRY {{ entry_num }}
                  {%- elsif index_ref != blank %} &middot; {{ index_ref | upcase }}
                  {%- endif -%}
                </div>
              </div>

            {%- when 'title' -%}
              {%- assign title_up = product.title | upcase -%}
              {%- assign title_first4 = title_up | slice: 0, 4 -%}
              <h1 class="led-name chunk pdp-name" {{ block.shopify_attributes }}>
                {%- if title_first4 == 'THE ' -%}
                  <span class="the">THE</span> {{ title_up | remove_first: 'THE ' | escape }}
                {%- else -%}
                  {{ title_up | escape }}
                {%- endif -%}
              </h1>

            {%- when 'price' -%}
              {%- assign next_block = section.blocks[forloop.index] -%}
              <div class="pdp-price-row" {{ block.shopify_attributes }}>
                <span class="pdp-price tag" data-price>
                  {%- for variant in product.variants -%}
                    <span
                      class="price{% if variant.compare_at_price > variant.price %} price--sale{% endif %}"
                      data-variant-price="{{ variant.id }}"
                      {% unless variant.id == current_variant.id %}hidden{% endunless %}
                    >
                      {%- if variant.compare_at_price > variant.price -%}
                        <s class="price__compare">{{ variant.compare_at_price | money }}</s>
                      {%- endif -%}
                      <span class="price__current">{{ variant.price | money }}</span>
                      {%- if cart.taxes_included %} <span class="price__vat">{{ 'products.inc_vat' | t }}</span>{% endif -%}
                      {%- if variant.unit_price_measurement -%}
                        <span class="price__unit">
                          {{- variant.unit_price | money }} /
                          {% if variant.unit_price_measurement.reference_value != 1 %}{{ variant.unit_price_measurement.reference_value }}{% endif %}{{ variant.unit_price_measurement.reference_unit -}}
                        </span>
                      {%- endif -%}
                    </span>
                  {%- endfor -%}
                </span>
                {%- if next_block.type == 'stock' -%}
                  {%- assign fold_stock_into_price = true -%}
                  <span
                    class="pdp-stock tag"
                    data-stock
                    data-state="{% if current_variant.available %}in-stock{% else %}sold-out{% endif %}"
                    data-label-in-stock="[ {{ 'products.in_stock' | t }} ]"
                    data-label-sold-out="[ {{ 'products.sold_out' | t }} ]"
                    {{ next_block.shopify_attributes }}
                  >
                    {%- if current_variant.available -%}
                      [ {{ 'products.in_stock' | t }} ]
                    {%- else -%}
                      [ {{ 'products.sold_out' | t }} ]
                    {%- endif -%}
                  </span>
                {%- endif -%}
              </div>

            {%- when 'stock' -%}
              {%- if fold_stock_into_price -%}
                {%- assign fold_stock_into_price = false -%}
              {%- else -%}
                <div class="pdp-stock-row" {{ block.shopify_attributes }}>
                  <span
                    class="pdp-stock tag"
                    data-stock
                    data-state="{% if current_variant.available %}in-stock{% else %}sold-out{% endif %}"
                    data-label-in-stock="[ {{ 'products.in_stock' | t }} ]"
                    data-label-sold-out="[ {{ 'products.sold_out' | t }} ]"
                  >
                    {%- if current_variant.available -%}
                      [ {{ 'products.in_stock' | t }} ]
                    {%- else -%}
                      [ {{ 'products.sold_out' | t }} ]
                    {%- endif -%}
                  </span>
                </div>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="pdp-options" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- if option.values.size > 1 -%}
                      {% render 'option-pills', option: option, option_index: option.position, bare: true %}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <div class="pdp-buy" {{ block.shopify_attributes }}>
                {%- form 'product', product -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">

                  {%- unless product.has_only_default_variant -%}
                    <noscript>
                      <select name="id" class="pdp-variant-select" aria-label="{{ product.title | escape }}">
                        {%- for variant in product.variants -%}
                          <option
                            value="{{ variant.id }}"
                            {% if variant.id == current_variant.id %}selected{% endif %}
                            {% unless variant.available %}disabled{% endunless %}
                          >
                            {{ variant.title | escape }}{% unless variant.available %} &mdash; {{ 'products.sold_out' | t }}{% endunless %}
                          </option>
                        {%- endfor -%}
                      </select>
                    </noscript>
                  {%- endunless -%}

                  {%- if section.settings.show_quantity -%}
                    <div class="pdp-qty">
                      <span class="tag tag-mute">[ {{ 'cart.quantity' | t }} ]</span>
                      <div class="qty-box">
                        <button type="button" class="qty-btn snap" data-qty-minus aria-label="Decrease quantity">&minus;</button>
                        <input
                          class="qty-input"
                          type="number"
                          name="quantity"
                          value="1"
                          min="1"
                          inputmode="numeric"
                          autocomplete="off"
                          aria-label="{{ 'cart.quantity' | t }}"
                        >
                        <button type="button" class="qty-btn snap" data-qty-plus aria-label="Increase quantity">+</button>
                      </div>
                    </div>
                  {%- endif -%}

                  <div class="pdp-actions">
                    <button
                      type="submit"
                      name="add"
                      class="directive directive--fill snap"
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      <span data-add-label {% unless current_variant.available %}hidden{% endunless %}>{{ 'products.add_to_cart' | t }}</span>
                      <span data-sold-label {% if current_variant.available %}hidden{% endif %}>{{ 'products.sold_out' | t }}</span>
                    </button>
                  </div>

                  {%- if section.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endform -%}
              </div>

            {%- when 'dossier' -%}
              {%- if product.metafields.custom.dossier != blank or product.description != blank or section.settings.hook_line != blank -%}
                <div class="pdp-dossier" {{ block.shopify_attributes }}>
                  {% render 'dossier', product: product, hide_strap: true %}
                  {%- if section.settings.hook_line != blank -%}
                    <p class="pdp-hook">{{ section.settings.hook_line | escape }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'field_manual' -%}
              <div class="pdp-field-manual" {{ block.shopify_attributes }}>
                {% render 'field-manual', product: product, care: section.settings.fm_care, delivery: section.settings.fm_delivery %}
              </div>

            {%- when 'trust_note' -%}
              {%- if block.settings.text != blank -%}
                <p class="tag tag-mute pdp-trust" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
              {%- endif -%}

            {%- when 'links' -%}
              {%- if section.settings.size_guide_page != blank or section.settings.returns_url != blank -%}
                <div class="pdp-links" {{ block.shopify_attributes }}>
                  {%- if section.settings.size_guide_page != blank -%}
                    <a href="{{ section.settings.size_guide_page.url }}" class="tag pdp-link">{{ section.settings.size_guide_label | default: 'SIZE GUIDE' }}</a>
                  {%- endif -%}
                  {%- if section.settings.size_guide_page != blank and section.settings.returns_url != blank -%}
                    <span class="tag tag-mute" aria-hidden="true">&middot;</span>
                  {%- endif -%}
                  {%- if section.settings.returns_url != blank -%}
                    <a href="{{ section.settings.returns_url }}" class="tag pdp-link">{{ section.settings.returns_label | default: 'RETURNS' }}</a>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'archive_note' -%}
              <div class="pdp-archive-note" {{ block.shopify_attributes }}>
                <hr class="sep-line">
                <span class="tag tag-mute">
                  {{- issue_val | upcase -}}
                  {%- if entry_num != blank and crumb_collection != blank -%}
                    {%- assign coll_total = crumb_collection.all_products_count -%}
                    {%- if coll_total < 10 -%}
                      {%- assign coll_total = coll_total | prepend: '0' -%}
                    {%- endif %} &middot; {{ entry_num }} OF {{ coll_total }}
                  {%- endif %} &middot; {{ block.settings.label | default: 'ARCHIVE ENTRY' }}
                </span>
              </div>

            {%- when 'custom_liquid' -%}
              {%- if block.settings.custom_liquid != blank -%}
                <div class="pdp-custom-liquid" {{ block.shopify_attributes }}>
                  {{ block.settings.custom_liquid }}
                </div>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}

        <script type="application/json" data-variant-json>
          {{ product.variants | json }}
        </script>
      </product-form>
    </div>

  </div>
</section>

{% stylesheet %}
.pdp-wrap [hidden] { display: none !important; }

/* Ledger blocks flow inside <product-form>; mirror the ledger's rhythm. */
product-form { display: block; }
.pdp-ledger product-form { display: flex; flex-direction: column; gap: var(--s3); }

.pdp-ledger .pdp-name { font-size: clamp(2.2rem, 5vw, 4rem); margin-bottom: 0; }

/* Kicker — "ISSUE_001 · ENTRY 02" with a short underline (mockup v27). */
.pdp-issue .pdp-kicker {
  display: inline-block;
  align-self: flex-start;
  letter-spacing: 0.25em;
  padding: 0 var(--s4) 12px 0;
  border-bottom: 1px solid var(--line-bri);
}

/* Stock reads as a quiet tag and only surfaces when it matters. */
.pdp-stock-row { display: flex; }
.pdp-stock[data-state="in-stock"] { display: none; }
.pdp-stock[data-state="sold-out"] { color: var(--bone-mute); }

/* Dossier on the PDP: bare paragraphs on the black wall, sentence case,
   with the red hook line as the punchline (mockup v27). */
.pdp-dossier { display: flex; flex-direction: column; gap: var(--s2); }
.pdp-dossier .dossier { background: none; border: none; padding: 0; }
.pdp-dossier .dossier p,
.pdp-dossier .dossier .dossier-desc p,
.pdp-dossier .dossier .dossier-desc li,
.pdp-dossier .dossier .metafield-rich_text_field p,
.pdp-dossier .dossier .metafield-rich_text_field li {
  font-family: var(--mono); text-transform: none;
  font-size: 14px; letter-spacing: 0.02em; line-height: 1.75;
  color: var(--bone);
}
.pdp-dossier .dossier p + p { margin-top: var(--s2); }
.pdp-hook {
  font-family: var(--mono); font-weight: 700; text-transform: uppercase;
  font-size: 15px; letter-spacing: 0.08em; color: var(--signal); margin: var(--s1) 0 0;
}

/* Option groups — bare COLOUR / SIZE labels over outlined pills. */
.pdp-options { display: flex; flex-direction: column; gap: var(--s3); }
.pdp-options .cw { border: none; padding: 0; margin-bottom: 0; }
.pdp-options .cw-label,
.pdp-options .sizes-label { display: block; color: var(--bone-mute); font-size: 10px; letter-spacing: 0.25em; margin-bottom: 10px; }
.pdp-options .sizes { margin-bottom: 0; flex-direction: column; align-items: flex-start; gap: 0; }
.pdp-options .cw-opt .dot { display: none; }
.pdp-options .cw-opt[aria-pressed="true"],
.pdp-options .size-pill[aria-pressed="true"] { background: transparent; color: #fff; border-color: var(--bone); }

/* Plain mono price on the black wall (mockup v27 — no boxed row). */
.pdp-price .price__current { font-family: var(--mono); font-size: 15px; letter-spacing: 0.12em; color: var(--bone); }
.price__unit { display: block; font-size: 10px; letter-spacing: 0.08em; color: var(--bone-mute); }

/* Plate frames — one per image media, toggled via [hidden]. */
[data-plate-frame] { display: contents; }
[data-plate-frame][hidden] { display: none !important; }
.pdp-gallery .plate {
  width: 100%;
  max-width: 500px;
  aspect-ratio: 1/1.12;
  margin: 0 auto;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.25);
}

/* Solid signal-red ADD TO BAG bar (mockup v27). */
.pdp-actions { display: flex; }
.pdp-buy .directive--fill {
  flex: 1; width: auto;
  background: var(--signal); border-color: var(--signal); color: #fff;
  font-family: var(--mono); letter-spacing: 0.2em;
}
.pdp-buy .directive--fill:hover { background: #fff; border-color: #fff; color: var(--ink); }
.pdp-buy .directive--fill[disabled] { background: transparent; border-color: var(--line); color: var(--bone-mute); }

.pdp-buy form { display: flex; flex-direction: column; gap: var(--s2); }
.pdp-variant-select {
  width: 100%;
  background: var(--panel-2);
  color: var(--bone);
  border: 1px solid var(--line-bri);
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 12px;
}

.pdp-qty { display: flex; align-items: center; gap: var(--s2); }
.qty-box { display: flex; border: 1px solid var(--line-bri); }
.qty-btn { width: 44px; padding: 10px 0; text-align: center; color: var(--bone); font-size: 15px; }
.qty-btn:hover { background: var(--panel-2); }
.qty-input {
  width: 56px;
  background: transparent;
  border: none;
  border-left: 1px solid var(--line-bri);
  border-right: 1px solid var(--line-bri);
  color: #fff;
  font-family: var(--mono);
  font-size: 13px;
  text-align: center;
  padding: 10px 0;
  appearance: textfield;
  -moz-appearance: textfield;
}
.qty-input::-webkit-outer-spin-button,
.qty-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

/* Dossier rich text: bold carries the .hit treatment; wrappers keep
   the 28px paragraph rhythm from theme.css. */
.dossier strong,
.dossier b { font-weight: 400; color: #fff; }
.dossier > p + div { margin-top: 28px; }

/* SIZE GUIDE · RETURNS + closing archive line. */
.pdp-links { display: flex; align-items: center; gap: var(--s2); }
.pdp-link { color: var(--bone-dim); text-decoration: underline; text-underline-offset: 4px; }
.pdp-link:hover { color: var(--signal); }
.pdp-archive-note { display: flex; flex-direction: column; gap: var(--s3); margin-top: var(--s2); }
.pdp-archive-note .tag { letter-spacing: 0.2em; }

/* Field manual COLOURWAYS auto-row reuses the swatch snippet for its
   display-name map — dots off, labels on. */
.fm-val--cw .dot { display: none; }
.fm-val--cw .cw-name { color: inherit; }

.pdp-trust { margin: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity stepper",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout buttons",
      "info": "Buy-it-now buttons styled by the payment provider, not the theme.",
      "default": false
    },
    {
      "type": "text",
      "id": "hook_line",
      "label": "Hook line",
      "info": "The red punchline under the description.",
      "default": "COME ON THEN."
    },
    {
      "type": "page",
      "id": "size_guide_page",
      "label": "Size guide page",
      "info": "Shown in the links row when set."
    },
    {
      "type": "text",
      "id": "size_guide_label",
      "label": "Size guide label",
      "default": "SIZE GUIDE"
    },
    {
      "type": "url",
      "id": "returns_url",
      "label": "Returns link",
      "info": "Shown in the links row when set."
    },
    {
      "type": "text",
      "id": "returns_label",
      "label": "Returns label",
      "default": "RETURNS"
    },
    {
      "type": "header",
      "content": "Field manual defaults"
    },
    {
      "type": "paragraph",
      "content": "Used for the auto-generated CARE and DELIVERY rows when a product has no field_manual metafield entries."
    },
    {
      "type": "text",
      "id": "fm_care",
      "label": "Care row",
      "default": "30°C // INSIDE OUT // NO TUMBLE — TUMBLE DRYERS ARE FOR QUITTERS"
    },
    {
      "type": "text",
      "id": "fm_delivery",
      "label": "Delivery row",
      "default": "FREE UK OVER £40 // 2–5 WORKING DAYS"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "issue_tag",
      "name": "Issue tag",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "stock",
      "name": "Stock status",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1
    },
    {
      "type": "dossier",
      "name": "Dossier",
      "limit": 1
    },
    {
      "type": "field_manual",
      "name": "Field manual",
      "limit": 1
    },
    {
      "type": "trust_note",
      "name": "Trust note",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "PRINTED WHEN YOU ORDER IT, NOT WAREHOUSED. ALLOW 5–10 WORKING DAYS. UK DELIVERY FREE OVER £40."
        }
      ]
    },
    {
      "type": "links",
      "name": "Size guide / returns",
      "limit": 1
    },
    {
      "type": "archive_note",
      "name": "Archive entry line",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "ARCHIVE ENTRY"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
