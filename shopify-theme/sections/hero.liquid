{% comment %}
  hero — mockup v27 split hero: flat black wall, copy column left
  (mono kicker, ChunkFive headline, solid signal-red CTA), skull &
  brollies artwork right. Framework CSS lives in theme.css §12a —
  the artwork is inverted/dimmed there to read as a grey print on
  the black wall. Artwork setting falls back to the packaged
  hero-skull-umbrella.png.
{% endcomment %}

{%- liquid
  assign cta_url = section.settings.cta_link | default: routes.all_products_collection_url
-%}

<section class="hero" data-section-id="{{ section.id }}">
  <div class="hero-copy">
    {%- if section.settings.kicker != blank -%}
      <span class="hero-kicker tag tag-mute">{{ section.settings.kicker | escape }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="chunk">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a class="hero-cta snap" href="{{ cta_url }}">{{ section.settings.cta_label | escape }}</a>
    {%- endif -%}
  </div>

  <div class="hero-art" aria-hidden="true">
    {%- if section.settings.artwork_image != blank -%}
      <img
        src="{{ section.settings.artwork_image | image_url: width: 1040 }}"
        srcset="
          {{ section.settings.artwork_image | image_url: width: 520 }} 520w,
          {{ section.settings.artwork_image | image_url: width: 1040 }} 1040w
        "
        sizes="(min-width: 861px) 520px, 68vw"
        alt=""
        width="{{ section.settings.artwork_image.width }}"
        height="{{ section.settings.artwork_image.height }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <img
        src="{{ 'hero-skull-umbrella.png' | asset_url }}"
        alt=""
        width="535"
        height="467"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker line",
      "default": "ISSUE_001 · THE FIRST COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "BUILT FOR THE STUBBORN."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "SEE THE COLLECTION"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link",
      "info": "Defaults to the all-products collection"
    },
    {
      "type": "image_picker",
      "id": "artwork_image",
      "label": "Artwork",
      "info": "Falls back to the packaged skull & brollies mark. Dark artwork on white or transparent reads best — the theme inverts it onto the black wall."
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
