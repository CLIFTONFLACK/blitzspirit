{% comment %}
  collection-hero — dark charcoal collection header, built on the exact
  same markup/CSS as page-hero.liquid (.about-hero/.page-hero, .ph-index/
  .ph-head/.ph-red/.ph-meta) so collection pages and content pages (About
  Us etc.) share one hero component. Those classes are styled once in
  page-hero.liquid's stylesheet — Shopify compiles all section
  stylesheets into one file, so re-declaring them here would just be
  duplication; this section relies on that shared styling intentionally.

  Reads collection.title / collection.description in place of page.title;
  supports the same red-first-line heading split and meta_tag blocks.
{% endcomment %}

{%- liquid
  assign display_title = collection.title
  if collection.handle == 'all'
    assign display_title = 'The Collections.'
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = display_title | default: section.settings.fallback_title | default: 'Full Kit.'
  endif
  assign heading_lines = heading | newline_to_br | split: '<br />'

  assign coll_ref = ''
  if section.settings.show_page_ref and display_title != blank
    assign coll_ref = display_title | remove: '.' | upcase | replace: ' ', '_'
  endif

  assign ph_style = ''
  if section.settings.texture_override != blank
    assign ph_style = ph_style | append: '--ph-tex: url(' | append: "'" | append: section.settings.texture_override | image_url: width: 1800 | append: "'" | append: '); '
  endif
  if section.settings.extra_height != blank and section.settings.extra_height != 0
    assign ph_style = ph_style | append: '--ph-extra-h: ' | append: section.settings.extra_height | append: 'px;'
  endif
-%}

<section
  class="about-hero page-hero page-hero--{{ section.settings.heading_size }}"
  data-section-id="{{ section.id }}"
  {% if ph_style != blank %}style="{{ ph_style }}"{% endif %}
>
  <div>
    {%- if section.settings.index_tag != blank or coll_ref != blank -%}
      <p class="led-index tag ph-index">
        [ {{ section.settings.index_tag | escape }}
        {%- if section.settings.index_tag != blank and coll_ref != blank %} // {% endif -%}
        {{ coll_ref }} ]
      </p>
    {%- endif -%}

    {%- if heading != blank -%}
      <h1 class="chunk ph-head">
        {%- for line in heading_lines -%}
          {%- assign line_text = line | strip -%}
          {%- if line_text == blank -%}{%- continue -%}{%- endif -%}
          {%- if forloop.first and section.settings.red_first_line and heading_lines.size > 1 -%}
            <span class="ph-red">{{ line_text }}</span>
          {%- else -%}
            {{ line_text }}
          {%- endif -%}
          {%- unless forloop.last -%}<br>{%- endunless -%}
        {%- endfor -%}
      </h1>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <p class="tag ph-meta">
        [
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank %} {{ block.settings.text | escape }}
            {%- unless forloop.last %} //{% endunless -%}
          {%- endif -%}
        {%- endfor %} ]
      </p>
    {%- elsif collection.description != blank -%}
      <div class="ph-meta">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection hero",
  "settings": [
    {
      "type": "text",
      "id": "index_tag",
      "label": "Index tag",
      "default": "SYSTEM_LEDGER // FULL_KIT // ISSUE_001",
      "info": "Rendered as [ TAG // COLLECTION_TITLE ]."
    },
    {
      "type": "checkbox",
      "id": "show_page_ref",
      "label": "Append collection title to the index tag",
      "default": true
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Headline override",
      "info": "Leave blank to use the collection title. New lines become line breaks; with the option below on, the first line prints brand red."
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Fallback title",
      "default": "Full Kit.",
      "info": "Shown when there's no collection title and no headline override."
    },
    {
      "type": "checkbox",
      "id": "red_first_line",
      "label": "Red first line",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Headline size",
      "options": [
        { "value": "xl", "label": "Extra large" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "xl"
    },
    {
      "type": "image_picker",
      "id": "texture_override",
      "label": "Backdrop texture override",
      "info": "Leave empty for the flat dark panel backdrop."
    },
    {
      "type": "range",
      "id": "extra_height",
      "label": "Extra height (px)",
      "min": 0,
      "max": 300,
      "step": 10,
      "default": 0,
      "info": "Added on top of the standard 65vh hero height."
    }
  ],
  "blocks": [
    {
      "type": "meta_tag",
      "name": "Meta tag",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "SCREEN PRINTED IN BRITAIN"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Collection hero",
      "blocks": [
        { "type": "meta_tag", "settings": { "text": "T-SHIRTS + CAPS" } },
        { "type": "meta_tag", "settings": { "text": "FREE UK DELIVERY OVER £40" } },
        { "type": "meta_tag", "settings": { "text": "SCREEN PRINTED IN BRITAIN" } }
      ]
    }
  ]
}
{% endschema %}
