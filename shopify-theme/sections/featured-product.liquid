{% comment %}
  featured-product — the ISSUE_000 50/50 elevated showcase
  (index.html "THE ESTABLISHMENT" band, 1:1 port).

  LEFT:  signal-outlined plate (plate snippet; eager — first plate on
         the page). RIGHT: dossier ledger — eyebrow/issue tag, title,
         dossier copy (richtext override → strapline/custom.dossier/
         description fallback — same chain as snippets/dossier.liquid,
         inlined because that snippet emits its own .dossier wrapper
         and this panel wraps eyebrow + name + form in one), price,
         and a REAL buy form per the <product-form> contract in
         docs/CONTRACTS.md.

  Framework CSS lives in theme.css §12b; the signal outline + price
  styling for the snippet-rendered .plate ship in the stylesheet below.
  Onboarding: no product selected → placeholder plate + neutral copy.
{% endcomment %}

{%- liquid
  assign product = section.settings.product

  assign issue_text = section.settings.issue_override
  if issue_text == blank
    assign issue_text = product.metafields.custom.issue | default: 'ISSUE_000 // LIMITED EDITION'
  endif

  assign title_up = product.title | upcase
  assign title_first4 = title_up | slice: 0, 4

  assign strapline = product.metafields.custom.strapline
  assign dossier_meta = product.metafields.custom.dossier

  assign featured_image_count = 0
  for media in product.media
    if media.media_type == 'image'
      assign featured_image_count = featured_image_count | plus: 1
    endif
  endfor
  assign featured_current_media_id = product.selected_or_first_available_variant.featured_media.id | default: product.featured_media.id
-%}

<section class="featured" data-section-id="{{ section.id }}" data-product-wrap>
  <div class="featured-visual">
    <span class="item-asset-ref tag">[ {{ issue_text | escape }} ]</span>
    <div class="pdp-gallery-row">
      {%- if featured_image_count > 1 -%}
        <div class="pdp-thumbs">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <button
                type="button"
                class="pdp-thumb snap"
                data-thumb
                data-media-id="{{ media.id }}"
                data-image-id="{{ media.preview_image.id }}"
                aria-pressed="{% if media.id == featured_current_media_id %}true{% else %}false{% endif %}"
                aria-label="{{ media.preview_image.alt | default: product.title | escape }}"
              >
                <img
                  src="{{ media.preview_image | image_url: width: 144 }}"
                  alt=""
                  width="144"
                  height="{{ 144 | divided_by: media.preview_image.aspect_ratio | round }}"
                  loading="lazy"
                >
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="pdp-gallery-main">
        {%- if featured_image_count > 0 -%}
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              {%- assign is_current = false -%}
              {%- if media.id == featured_current_media_id -%}
                {%- assign is_current = true -%}
              {%- endif -%}
              <div data-plate-frame data-media-id="{{ media.id }}" data-image-id="{{ media.preview_image.id }}" {% unless is_current %}hidden{% endunless %}>
                {% render 'plate', image: media.preview_image, ref_text: section.settings.plate_ref, alt: product.title, priority: is_current, sizes: '(min-width: 860px) 38vw, 78vw' %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <div data-plate-frame>
            {% render 'plate', ref_text: section.settings.plate_ref, alt: product.title %}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="featured-ledger">
    <div class="dossier">
      <span class="featured-eyebrow">★ {{ issue_text | escape }}</span>

      {%- if product != blank -%}
        <h2 class="featured-name chunk">
          {%- if title_first4 == 'THE ' -%}
            <span class="the">THE</span> {{ title_up | remove_first: 'THE ' }}
          {%- else -%}
            {{ title_up }}
          {%- endif -%}
        </h2>

        <div class="featured-price tag">{% render 'price', product: product %}</div>

        {%- if section.settings.dossier != blank -%}
          {{ section.settings.dossier }}
        {%- else -%}
          {%- if strapline != blank -%}
            <p>
              <span class="hit">// {{ title_up }}</span>
              &mdash; {{ strapline | escape }}
            </p>
          {%- endif -%}
          {%- if product.description != blank -%}
            <div class="dossier-desc">{{ product.description }}</div>
          {%- elsif dossier_meta != blank -%}
            {{ dossier_meta | metafield_tag }}
          {%- endif -%}
        {%- endif -%}

        <product-form data-section-id="{{ section.id }}">
          {%- form 'product', product -%}
            <input
              type="hidden"
              name="id"
              value="{{ product.selected_or_first_available_variant.id }}"
            >

            {%- unless product.has_only_default_variant -%}
              {%- assign featured_has_other_options = false -%}
              {%- for option in product.options_with_values -%}
                {%- assign featured_opt_down = option.name | downcase -%}
                {%- unless featured_opt_down == 'colour' or featured_opt_down == 'color' -%}
                  {%- assign featured_has_other_options = true -%}
                {%- endunless -%}
              {%- endfor -%}
              {%- if featured_has_other_options -%}
                <div class="cw-size-wrap">
                  {%- for option in product.options_with_values -%}
                    {%- assign featured_opt_down = option.name | downcase -%}
                    {%- unless featured_opt_down == 'colour' or featured_opt_down == 'color' -%}
                      {% render 'option-pills', option: option, option_index: option.position %}
                    {%- endunless -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            {%- endunless -%}

            <script type="application/json" data-variant-json>
              {{ product.variants | json }}
            </script>

            <div class="actions">
              {%- if section.settings.what_label != blank -%}
                <a class="what-link snap" href="{{ product.url }}">
                  {{- title_up }} {{ section.settings.what_label | escape }}
                </a>
              {%- endif -%}
              <button
                type="submit"
                name="add"
                class="directive snap"
                {% unless product.available %}disabled{% endunless %}
              >
                {%- if product.available -%}
                  [ {{ 'products.add_to_cart' | t }} ]
                {%- else -%}
                  [ {{ 'products.sold_out' | t }} ]
                {%- endif -%}
              </button>
            </div>
          {%- endform -%}
        </product-form>
      {%- else -%}
        <h2 class="featured-name chunk">FEATURED PRODUCT</h2>
        {%- if section.settings.dossier != blank -%}
          {{ section.settings.dossier }}
        {%- else -%}
          <p>SELECT A PRODUCT IN THE THEME EDITOR TO POPULATE THIS SHOWCASE.</p>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.featured-visual .plate {
  width: min(73%, 486px);
  aspect-ratio: 1 / 1.12;
  box-shadow: 0 30px 90px rgba(0, 0, 0, 0.7);
  outline: 2px solid var(--signal);
  outline-offset: 10px;
}
.featured-visual .plate svg {
  width: 100%;
  height: 100%;
}
.featured .dossier .featured-price {
  display: block;
  margin: 0 0 var(--s3);
  color: var(--dossier-ink);
  font-size: 14px;
  letter-spacing: 0.12em;
}
.featured .dossier strong {
  font-weight: 400;
  color: #0a0a0a;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Featured product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "issue_override",
      "label": "Issue tag override",
      "info": "Falls back to the product's custom.issue metafield, then ISSUE_000 // LIMITED EDITION"
    },
    {
      "type": "richtext",
      "id": "dossier",
      "label": "Dossier copy override",
      "info": "Falls back to the product's custom.dossier metafield, then its description"
    },
    {
      "type": "text",
      "id": "what_label",
      "label": "Product link label",
      "default": "STORY",
      "info": "Rendered as PRODUCT NAME STORY — leave blank to hide the link"
    },
    {
      "type": "text",
      "id": "plate_ref",
      "label": "Plate corner reference",
      "default": "BS_002 // ISSUE_000"
    }
  ],
  "presets": [
    {
      "name": "Featured product"
    }
  ]
}
{% endschema %}
