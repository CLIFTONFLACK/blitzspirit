---
// Base — ported from layout/theme.liquid.
//
// Same order as the Liquid layout: head, skip link, header group
// (announcement bar + masthead), <main>, footer group (outro), cart drawer,
// signup modal, then the four scripts.
//
// Dropped from the original: content_for_header (Shopify's own script/pixel
// injection), request.locale (single locale), and the theme-settings favicon
// picker.
import '~/styles/tokens.css';
import '~/styles/theme.css';

import MetaTags from '~/components/MetaTags.astro';
import StructuredData from '~/components/StructuredData.astro';
import AnnouncementBar from '~/components/AnnouncementBar.astro';
import Masthead from '~/components/Masthead.astro';
import Outro from '~/components/Outro.astro';
import CartDrawer from '~/components/CartDrawer.astro';
import SignupModal from '~/components/SignupModal.astro';

import settings from '~/data/settings.json';
import strings from '~/data/strings.json';
import { href } from '~/lib/url';
import type { Collection, Product } from '~/lib/catalogue';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'product';
  /** Feeds the Product / BreadcrumbList JSON-LD, as `product` and `collection` did
   *  in the Liquid layout's structured-data render. */
  product?: Product;
  collection?: Collection;
}

const { title, description, image, ogType, product, collection } = Astro.props;

// Each skinned EDITION is this same source built a second time under its own base
// (astro.neo.config.mjs, astro.skeuo.config.mjs), so the base IS the edition's
// identity - no environment variable, no build flag, nothing to keep in sync. A
// skin is a public/ stylesheet rather than an import so the main shop, built from
// the same layout, never carries a byte of one.
//
// Adding an edition is a row here plus a config, a merge script and a stylesheet.
interface Edition {
  /** Value of <html data-skin>, which is what a skin stylesheet hangs off. */
  skin: string;
  /** Value of <html data-room>, for an edition that DERIVES from a skin rather
   *  than replacing it: /pub is the skeuomorphic skin in a different room, so it
   *  loads skeuo.css and then pub.css, which re-dresses it. */
  room?: string;
  /** Stylesheets, in cascade order - the last one wins a tie. Paths are within
   *  the edition's base, so href() carries it. */
  css: string[];
  themeColour: string;
  label: string;
}
const EDITIONS: Record<string, Edition> = {
  '/neomorphism': {
    skin: 'neo',
    css: ['/neo.css'],
    themeColour: '#15171B',
    label: 'NEOMORPHISM EDITION',
  },
  '/skeuomorphism': {
    skin: 'skeuo',
    css: ['/skeuo.css'],
    themeColour: '#1F1409',
    label: 'SKEUOMORPHISM EDITION',
  },
  '/pub': {
    skin: 'skeuo',
    room: 'pub',
    css: ['/skeuo.css', '/pub.css'],
    themeColour: '#150E07',
    label: 'THE SNUG',
  },
};

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const edition: Edition | undefined = EDITIONS[base];


// theme.liquid: append the shop name unless the title already carries it.
const fullTitle = title.includes(settings.shop.name)
  ? title
  : `${title} – ${settings.shop.name}`;
---
<!doctype html>
<html class="no-js" lang="en-GB" data-skin={edition?.skin} data-room={edition?.room}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={edition?.themeColour ?? '#0A0A0A'} />

    {/* A skinned edition is the same copy at a second address. Left indexable it
        would compete with the shop for its own terms, so it is kept out of the index
        (the sitemap already excludes it - the edition configs ship none). */}
    {edition && <meta name="robots" content="noindex, follow" />}
    {edition?.css.map((sheet) => <link rel="stylesheet" href={href(sheet)} />)}

    <title>{fullTitle}</title>

    <MetaTags title={fullTitle} description={description} image={image} ogType={ogType} />

    <StructuredData product={product} collection={collection} productImage={image} />

    <link rel="icon" type="image/png" href={href("/assets/blitzspirit-stamp.png")} />

    <link
      rel="preload"
      href={href("/assets/fonts/chunkfive.woff2")}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <script is:inline>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>

  <body>
    <a class="skip-to-content-link tag" href="#MainContent">{strings.general.skip_to_content}</a>

    <AnnouncementBar />
    <Masthead />

    <main id="MainContent" tabindex="-1">
      <slot />
    </main>

    <Outro />

    {/* Every edition is real and reachable; the only route back to the shop would
        otherwise be the address bar. */}
    {edition && (
      <a class="edition-mark" href="/" data-cross-edition title={`Leave the ${edition.skin} edition`}>
        {edition.label} // BACK TO THE SHOP
      </a>
    )}

    <CartDrawer />
    <SignupModal />

    <script>
      import '~/scripts/cart.js';
      import '~/scripts/product-form.js';
      import '~/scripts/modal.js';
      import '~/scripts/reveal.js';
      import '~/scripts/newsletter.js';
    </script>
  </body>
</html>
