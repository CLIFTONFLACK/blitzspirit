---
// StubbornTitle — a title band under the hero: BUILT FOR THE STUBBORN as rusty
// cast-brass lettering on an oak panel. The whole visual is one generated photo
// (tools/openart, 2026-10-06) set as the section's background, the same way the
// hero works: the h2 keeps the real words in the DOM for screen readers and
// search, visually hidden under the photo. One image, letterboxed by its own
// aspect ratio so the lettering is never cropped.
//
// On first scroll into view (reveal.js adds .in) the panel fades up and the
// light sweeps once across the brass; none of that under reduced motion.
import { href } from '~/lib/url';

interface Props {
  heading?: string;
}

const { heading = 'BUILT FOR THE STUBBORN' } = Astro.props;
---
<link rel="preload" as="image" href={href('/assets/backgrounds/stubborn-brass.jpg')} />
<section class="stubborn-title reveal">
  <h2 class="chunk stubborn-head">{heading}</h2>
  <span class="stubborn-sheen" aria-hidden="true"></span>
</section>

<style>
  /* One render: BUILT FOR THE STUBBORN on a single line, same size every
     letter, on oak. Cropped to a 2400x665 strip around the lettering and
     set to cover, so the brass scales with the width and the band stays
     short with a thin wood margin above and below. */
  .stubborn-title {
    position: relative;
    width: 100%;
    height: clamp(128px, 12vw, 232px);
    border-bottom: 1px solid var(--line);
    background: #2a1d12 url('/assets/backgrounds/stubborn-brass.jpg') center / cover no-repeat;
    overflow: hidden;
  }
  /* Real text for assistive tech and crawlers; the photo is the visual. */
  .stubborn-head {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  /* One light sweep across the brass once the band is in view. */
  .stubborn-sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 40%,
      rgba(255, 236, 190, 0.22) 50%,
      transparent 60%
    );
    transform: translateX(-120%);
  }
  html.js .stubborn-title:not(.in) { opacity: 0; transform: translateY(16px); }
  .stubborn-title.in { opacity: 1; transform: none; transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .stubborn-title.in .stubborn-sheen { animation: stubborn-sweep 1.6s cubic-bezier(0.4, 0, 0.2, 1) 0.5s 1 forwards; }
  @keyframes stubborn-sweep {
    from { transform: translateX(-120%); }
    to { transform: translateX(120%); }
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .stubborn-title:not(.in) { opacity: 1; transform: none; }
    .stubborn-title.in { transition: none; }
    .stubborn-title.in .stubborn-sheen { animation: none; }
  }
</style>
