---
// StubbornTitle — a title band under the hero: the words BUILT FOR THE STUBBORN
// in ChunkFive, filled with Union Jack colours and engraved into the concrete
// panel backdrop. Pure CSS: a dark offset copy and a pale offset copy behind the
// text give the cut-in edge, the front copy carries the flag gradient clipped
// to the glyphs and multiplied into the concrete so it reads as stained stone
// rather than a sticker. The data-text attribute feeds the two pseudo copies.
//
// Under prefers-reduced-motion the pieces are simply in place; otherwise the
// three words slide in one after another on first scroll into view (reveal.js
// adds .in).
interface Props {
  heading?: string;
}

const { heading = 'BUILT FOR THE STUBBORN' } = Astro.props;
const words = heading.split(' ');
---
<section class="stubborn-title reveal" aria-label={heading}>
  <h2 class="chunk stubborn-head">
    {words.map((word, i) => (
      <span class="stubborn-word" data-text={word} style={`--i:${i}`}>{word}</span>
    ))}
  </h2>
</section>

<style>
  .stubborn-title {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 240px;
    padding: var(--s5) var(--s3);
    border-bottom: 1px solid var(--line);
    background: var(--paper) url('/assets/backgrounds/concrete-panel.jpg') center/cover no-repeat;
    overflow: hidden;
  }
  /* A faint vignette so the panel edges read as a wall, not a flat tile. */
  .stubborn-title::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.18) 100%);
  }
  .stubborn-head {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.28em;
    font-size: clamp(2.6rem, 9vw, 7.5rem);
    line-height: 0.92;
    letter-spacing: 0.01em;
    text-align: center;
    margin: 0;
  }
  .stubborn-word {
    position: relative;
    display: inline-block;
    /* Union Jack: red, white, blue. Clipped to the letterforms and multiplied
       so the concrete grain shows through the colour. */
    background: linear-gradient(
      180deg,
      #C8102E 0%,
      #C8102E 36%,
      #F2F0EA 36%,
      #F2F0EA 58%,
      #012169 58%,
      #012169 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    mix-blend-mode: multiply;
    filter: contrast(1.05) saturate(0.9);
  }
  /* Engraved edge: a dark copy offset down-right (the shadow inside the cut)
     and a pale copy offset up-left (the lit rim of the cut). Both sit behind
     the coloured glyphs. */
  .stubborn-word::before,
  .stubborn-word::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    z-index: -1;
    color: transparent;
    -webkit-background-clip: initial;
    background-clip: initial;
    background: none;
    mix-blend-mode: normal;
    pointer-events: none;
  }
  .stubborn-word::before {
    text-shadow: 2px 3px 2px rgba(0, 0, 0, 0.55), 1px 1px 0 rgba(0, 0, 0, 0.45);
    transform: translate(0, 0);
  }
  .stubborn-word::after {
    text-shadow: -1px -1px 0 rgba(255, 255, 255, 0.55);
  }

  /* Reveal: words drop into the wall one after another. */
  html.js .stubborn-title:not(.in) .stubborn-word {
    opacity: 0;
    transform: translateY(0.35em) scale(1.04);
    filter: blur(2px);
  }
  .stubborn-title.in .stubborn-word {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 0.14s),
      transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 0.14s),
      filter 0.55s ease calc(var(--i) * 0.14s);
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .stubborn-title:not(.in) .stubborn-word { opacity: 1; transform: none; filter: contrast(1.05) saturate(0.9); }
    .stubborn-title.in .stubborn-word { transition: none; }
  }
  @media (max-width: 860px) {
    .stubborn-title { min-height: 180px; padding: var(--s4) var(--s2); }
    .stubborn-head { gap: 0 0.22em; }
  }
</style>
