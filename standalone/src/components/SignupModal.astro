---
// SignupModal — ported from sections/signup-modal.liquid.
// Copy comes from the v27 section defaults; timings and the discount code from
// src/data/settings.json. modal.js contract is unchanged, including the
// localStorage keys bs_signed_up and bs_modal_seen.
import Icon from './Icon.astro';
import NewsletterForm from './NewsletterForm.astro';
import settings from '~/data/settings.json';
import strings from '~/data/strings.json';

const modal = settings.signupModal;
const waitlist = settings.waitlist;

// Waitlist for The Establishment tee (2026-10-06). The countdown target is
// settings.waitlist.availableAt; modal.js ticks it from data-available-at.
const content = {
  eyebrow: 'DISPATCHES',
  // U+2011 non-breaking hyphen: keeps "T-shirt" on one line in the headline.
  heading: `Join the waitlist for ${waitlist.product} t‑shirt.`,
  subheading: 'Available in',
  body: 'First in the queue gets first dibs, plus a code for 10% off. That is all. No spam — that would be nonsense.',
  buttonLabel: '[ JOIN THE WAITLIST ]',
  dismissLabel: 'No thanks — I’ll take my chances',
  carryOnLabel: '[ CARRY ON SHOPPING ]',
};
const units = [
  ['days', 'DAYS'],
  ['hours', 'HRS'],
  ['minutes', 'MIN'],
  ['seconds', 'SEC'],
];
---
{modal.enabled && (
  <dialog
    class="signup-modal"
    id="SignupModal"
    data-enabled="true"
    data-delay={String(modal.delaySeconds)}
    data-suppress-days={String(modal.suppressDays)}
    data-exit-intent={modal.exitIntent ? 'true' : 'false'}
    data-discount-code={settings.discount.code}
    data-available-at={waitlist.availableAt}
    aria-labelledby="SignupModalHeading"
  >
    <div class="signup-inner">
      <span class="frame-tick frame-tick--tl" aria-hidden="true"></span>
      <span class="frame-tick frame-tick--br" aria-hidden="true"></span>

      <button type="button" class="signup-close snap" data-modal-close aria-label={strings.accessibility.close_dialog}>
        <Icon name="close" />
      </button>

      <h2 class="chunk signup-head" id="SignupModalHeading">{content.heading}</h2>

      <p class="signup-sub eyebrow">{content.subheading}</p>

      <div class="signup-countdown" data-countdown role="timer" aria-live="off">
        {units.map(([key, label]) => (
          <div class="signup-count">
            <b class="chunk" data-countdown-unit={key}>00</b>
            <span class="eyebrow">{label}</span>
          </div>
        ))}
      </div>

      <p class="signup-body">{content.body}</p>

      <NewsletterForm id="SignupModalForm" buttonLabel={content.buttonLabel} tags="waitlist,establishment,backbone10" />

      <button type="button" class="signup-dismiss snap" data-modal-close>
        {content.dismissLabel}
      </button>

      <button type="button" class="btn snap signup-carry" data-modal-close>
        {content.carryOnLabel}
      </button>
    </div>
  </dialog>
)}

<style is:global>
  dialog.signup-modal {
    background: var(--panel);
    border: 1px solid var(--line-bri);
    padding: 0;
    width: min(520px, calc(100% - 32px));
    color: var(--bone);
  }
  dialog.signup-modal::backdrop { background: rgba(255, 255, 255, 0.88); }
  .signup-inner {
    position: relative;
    padding: var(--s5) var(--s4) var(--s4);
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    text-align: left;
  }
  .frame-tick { position: absolute; width: 14px; height: 14px; border: 2px solid var(--accent); }
  .frame-tick--tl { top: 10px; left: 10px; border-right: none; border-bottom: none; }
  .frame-tick--br { bottom: 10px; right: 10px; border-left: none; border-top: none; }
  .signup-close {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bone);
    line-height: 0;
  }
  .signup-close:hover { color: var(--accent); }
  .signup-head { color: var(--ink); font-size: clamp(1.8rem, 5vw, 2.6rem); }
  .signup-sub { color: var(--accent); }
  .signup-countdown[hidden] { display: none; }
  .signup-countdown {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s1);
    border: 1px solid var(--line-bri);
  }
  .signup-count {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--s2) 0 var(--s1);
    border-right: 1px solid var(--line);
  }
  .signup-count:last-child { border-right: none; }
  .signup-count b { font-size: clamp(1.8rem, 6vw, 2.6rem); color: var(--ink); font-variant-numeric: tabular-nums; }
  .signup-count .eyebrow { color: var(--bone-mute); font-size: 10px; }
  .signup-countdown.is-live b { color: var(--accent); }
  .signup-body {
    color: var(--bone-mute);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.75;
  }
  .signup-dismiss {
    align-self: center;
    min-height: 44px;
    padding: 0 var(--s1);
    color: var(--bone-mute);
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .signup-dismiss:hover { color: var(--accent); }
  .signup-carry { display: none; }
  /* The success block is hidden until newsletter.js reveals it, so :has() has
     to test for it being present AND shown - [hidden] is the off state now,
     where in the Liquid version the block simply did not exist. */
  .signup-inner:has([data-signup-success]:not([hidden])) .signup-carry { display: block; }
  .signup-inner:has([data-signup-success]:not([hidden])) .signup-dismiss,
  .signup-inner:has([data-signup-success]:not([hidden])) .signup-body,
  .signup-inner:has([data-signup-success]:not([hidden])) .signup-sub { display: none; }
</style>
