---
// Masthead — no nav bar: just social + bag, floating over whatever sits at
// the top of the page (the hero photo on the homepage, plain page content
// everywhere else). The full text nav (site menu, dropdowns) was dropped —
// the footer (Outro.astro) still carries About/Size Guide/Returns/Contact.
//
// cart.js contract preserved exactly: [data-cart-toggle] opens the drawer and
// [data-cart-count] is the live count target. The bag link stays a real /cart
// anchor so a no-JS visitor lands on the full ledger page.
import Icon from './Icon.astro';
import settings from '~/data/settings.json';
import { href } from '~/lib/url';

const social = settings.social;
const socialLinks = [
  { key: 'instagram', url: social.instagram, label: 'Instagram' },
  { key: 'tiktok', url: social.tiktok, label: 'TikTok' },
  { key: 'x', url: social.x, label: 'X' },
  { key: 'facebook', url: social.facebook, label: 'Facebook' },
].filter((s) => s.url !== '');
---
<header class="masthead">
  <div class="nodes nodes--right">
    {socialLinks.map((s) => (
      <a
        href={s.url}
        class="mh-social"
        aria-label={s.label}
        target="_blank"
        rel="noopener noreferrer">
        <Icon name={s.key as any} />
      </a>
    ))}
    <a
      href={href("/cart")}
      class="mh-social bag"
      data-cart-toggle
      aria-controls="CartDrawer"
      aria-expanded="false"
      aria-label="Open bag">
      <Icon name="bag" />
      <b data-cart-count>0</b>
    </a>
  </div>
</header>
