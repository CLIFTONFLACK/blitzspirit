---
// Hero — one text-free photo (hero-stubborn.jpg: man + skull-and-brollies
// emblem on a concrete wall). The headline and CTA are real HTML overlaid on
// the empty wall at left (theme.css §12a), set in ChunkFive via `.chunk`.
// The previous baked-text hero now lives on as StubbornStrip above the footer.
import { href } from '~/lib/url';

interface Props {
  heading?: string;
  ctaLabel?: string;
  ctaLink?: string;
  /** Address prefix for the inline copy editor, e.g. "pages/index:hero". */
  editBase?: string;
}

const {
  heading = 'BUILT FOR THE STUBBORN.',
  ctaLabel = 'SHOP THE COLLECTION',
  ctaLink = '/collections/all',
  editBase,
} = Astro.props;
---
<link rel="preload" as="image" href={href('/assets/backgrounds/hero-stubborn.jpg')} fetchpriority="high" />
<section class="hero">
  <div class="hero-copy">
    {heading && <h1 class="chunk hero-title" data-line-id={editBase && `${editBase}.settings.heading`}>{heading.replace(/ (THE )/i, '\n$1')}</h1>}
    <span class="hero-rule" aria-hidden="true"></span>
    {ctaLabel && <a class="hero-cta" href={href(ctaLink)}>{ctaLabel} <span aria-hidden="true">→</span></a>}
  </div>
</section>
