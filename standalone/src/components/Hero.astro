---
// Hero — ported from sections/hero.liquid (the v27 split hero).
//
// Copy column left (mono kicker, headline, CTA), skull & brollies artwork
// right — but both the headline and the artwork are one single generated
// photo now (tools/openart): the whole design carved/painted into one
// continuous concrete wall, set as `.hero`'s own background (theme.css
// §12a). Two separate generated images (one behind the heading, one behind
// the artwork column) each carried their own baked-in patch of concrete,
// which read as two pasted-on tiles rather than one wall — a single wide
// photo avoids that seam entirely. The h1 keeps its real text in the DOM
// (accessible/SEO) positioned over the image's own text half; `.hero-art`
// is now just an empty spacer holding the grid's right column open so the
// copy column sits where the photo's text half actually is.
import { href } from '~/lib/url';

interface Props {
  heading?: string;
  ctaLabel?: string;
  ctaLink?: string;
  /** Address prefix for the inline copy editor, e.g. "pages/index:hero". */
  editBase?: string;
}

const {
  heading = 'BUILT FOR THE STUBBORN.',
  ctaLabel = 'SEE THE COLLECTION',
  ctaLink = '',
  editBase,
} = Astro.props;

// Liquid: section.settings.cta_link | default: routes.all_products_collection_url
const ctaUrl = ctaLink || '/collections/all';
---
{/* No <Image>/<img> renders this hero anymore (it's a CSS background-image
    carrying the whole visual, likely the page's LCP element), so nothing
    hints the browser to fetch it early the way astro:assets' `loading="eager"
    fetchpriority="high"` used to. A plain <link preload> stands in — browsers'
    preload scanners process it wherever it sits, not just in <head>. Two
    variants, gated by `media` to match theme.css's own breakpoint, so a
    phone doesn't fetch the unused desktop image (or vice versa). */}
<link rel="preload" as="image" href={href('/assets/backgrounds/hero-engraved.jpg')} media="(min-width: 861px)" fetchpriority="high" />
<link rel="preload" as="image" href={href('/assets/backgrounds/hero-engraved-mobile.jpg')} media="(max-width: 860px)" fetchpriority="high" />
<section class="hero">
  <div class="hero-copy">
    {heading && <h1 class="chunk" data-line-id={editBase && `${editBase}.settings.heading`}>{heading}</h1>}
    {ctaLabel && <a class="hero-cta snap" href={href(ctaUrl)} data-line-id={editBase && `${editBase}.settings.cta_label`}>{ctaLabel}</a>}
  </div>

  <div class="hero-art" aria-hidden="true"></div>
</section>
