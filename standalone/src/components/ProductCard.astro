---
// ProductCard — ported from snippets/product-card.liquid.
//
// Plate image with a hover swap to the second photo, LIMITED badge, colour dots,
// price, then two controls: a [ VIEW ] link to the product page and an
// [ ADD TO CART ] button. Class names are unchanged so the .coll-card CSS that
// ships with the collection sections still applies.
//
// [ ADD TO CART ] never adds anything by itself: a card shows no size, so a
// one-tap add could only ever pick the first variant (size S) without asking,
// which is what it used to do. It opens a modal size picker instead
// (card-pick.js), and the tap on a size is what adds that size to the bag.
//
// The modal is a native <dialog> and is its own [data-product-wrap], so the
// <product-form> inside it is scoped to it: product-form.js keeps the hidden id
// input in step with the pills, disables sold-out sizes and swaps the modal's
// photo when a colour is chosen, exactly as on the product page, and cart.js
// adds whatever id that input holds. The add button itself stays hidden;
// card-pick.js presses it once a size has been chosen.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Swatch from './Swatch.astro';
import Price from './Price.astro';
import OptionPills from './OptionPills.astro';
import strings from '~/data/strings.json';
import { asset, assetOrNull } from '~/lib/images';
import {
  colourMedia,
  firstAvailableVariant,
  mediaForColour,
  pickerOptions,
  variantFormData,
  type Product,
} from '~/lib/catalogue';
import { href } from '~/lib/url';

interface Props {
  product: Product;
  showBadge?: boolean;
}
const { product, showBadge = false } = Astro.props;

const titleUp = product.title.toUpperCase();
const startsWithThe = titleUp.startsWith('THE ');

const primary = product.media[0] ? asset(product.media[0].src) : null;
const hover = assetOrNull(product.media[1]?.src);

const available = product.variants.some((v) => v.available);
const variant = firstAvailableVariant(product);
const currentMedia = mediaForColour(product, variant.options.Colour);

const colourOption = product.options.find((o) => ['Colour', 'Color'].includes(o.name));
const isColour = (name: string) => ['colour', 'color'].includes(name.toLowerCase());

const pickers = pickerOptions(product);
// A size tap is the only thing that adds from a card. A product with nothing to
// pick a size from (one size, or colours only) gets a plain link to its page
// instead of a picker that could never add.
const hasSizePick = pickers.some(({ option }) => !isColour(option.name));
const pickId = `CardPick-${product.handle}`;
const productUrl = href(`/products/${product.handle}`);
const sizes = '(min-width: 860px) 33vw, (min-width: 540px) 50vw, 100vw';
---
<article class="coll-card">
  <a href={productUrl} class="coll-plate">
    {primary ? (
      <>
        <Image
          src={primary}
          alt={product.media[0].alt ?? product.title}
          widths={[400, 600, 800]}
          sizes={sizes}
          loading="lazy"
        />
        {hover && (
          <Image
            class="coll-img--hover"
            src={hover}
            alt=""
            widths={[400, 600, 800]}
            sizes={sizes}
            loading="lazy"
            aria-hidden="true"
          />
        )}
      </>
    ) : (
      <div class="plate__placeholder" aria-hidden="true"></div>
    )}
    {showBadge && product.limited && <span class="coll-badge">LIMITED EDITION</span>}
  </a>
  <div class="coll-info">
    <h3 class="chunk coll-name" data-line-id={`catalogue:${product.handle}.title`}>
      {startsWithThe ? (
        <><span class="the">THE</span> {titleUp.replace(/^THE /, '')}</>
      ) : (
        titleUp
      )}
    </h3>
    {/* Says what the thing is: a name like THE FREQUENCY does not. */}
    {product.type && <span class="eyebrow coll-type">{product.type}</span>}
    {colourOption && (
      <div class="coll-dots">
        {colourOption.values.map((v) => <Swatch value={v.value} />)}
      </div>
    )}
    <span class="coll-price"><Price product={product} showVat={false} /></span>
    <div class="coll-actions">
      <a href={productUrl} class="coll-cta snap">[ {strings.products.view} ]</a>
      {hasSizePick ? (
        <button
          type="button"
          class="btn btn--solid snap coll-buy"
          data-card-pick
          data-fallback-href={productUrl}
          aria-haspopup="dialog"
          aria-controls={pickId}
          disabled={!available}
        >[ {available ? strings.products.add_to_cart : strings.products.sold_out} ]</button>
      ) : (
        <a href={productUrl} class="btn btn--solid snap coll-buy">
          [ {available ? strings.products.add_to_cart : strings.products.sold_out} ]
        </a>
      )}
    </div>
  </div>

  {hasSizePick && (
    <dialog class="card-pick-modal" id={pickId} data-product-wrap aria-labelledby={`${pickId}-title`}>
      <div class="card-pick-inner">
        <button
          type="button"
          class="card-pick-close snap"
          data-card-pick-close
          aria-label={strings.accessibility.close_dialog}
        >
          <Icon name="close" />
        </button>

        <div class="card-pick-head">
          {/* One photo per colourway; product-form.js shows the one for the colour
              picked by toggling [hidden]. Eager: a lazy image inside a closed
              dialog never starts loading, so the photo would arrive after the
              modal opened. They are 240px wide, so the cost is small. */}
          <div class="card-pick-photo">
            {colourMedia(product).map((media) => (
              <Image
                src={asset(media.src)}
                alt={media.alt ?? product.title}
                width={240}
                loading="eager"
                decoding="async"
                data-plate-frame
                data-media-id={media.colour}
                hidden={media !== currentMedia}
              />
            ))}
          </div>
          <div class="card-pick-summary">
            <h2 class="chunk card-pick-title" id={`${pickId}-title`}>{titleUp}</h2>
            {product.type && <span class="eyebrow coll-type">{product.type}</span>}
            <span class="coll-price"><Price product={product} showVat={false} /></span>
          </div>
        </div>

        <product-form class="coll-pick" data-colour-any-size>
          <p class="eyebrow coll-pick-hint">{strings.products.pick_size}</p>

          {/* Colour keeps its current value pressed; size starts with nothing
              pressed, because the tap on a size is the add. */}
          {pickers.map(({ option, index }) => (
            <OptionPills
              option={option}
              optionIndex={index}
              selected={isColour(option.name) ? variant.options[option.name] : ''}
              bare={true}
            />
          ))}

          <script
            type="application/json"
            data-variant-json
            is:inline
            set:html={JSON.stringify(variantFormData(product, (media) => media.colour))}
          />
          <input type="hidden" name="id" value={variant.id} />
          <button type="button" name="add" data-add-to-cart hidden tabindex="-1" disabled={!variant.available}></button>
        </product-form>

        <a href={productUrl} class="eyebrow card-pick-more">{strings.products.view_details}</a>
      </div>
    </dialog>
  )}
</article>
