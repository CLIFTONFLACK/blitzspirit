---
// AsSeenOn — the ironic inverse of a normal "as seen on" logo strip. Most
// brands borrow credibility from press/TV/shop placement or an influencer
// deal; this one says plainly it has none of that, on purpose. Four small
// hand-drawn icons (shop, TV, newspaper, megaphone) each carry a diagonal
// strike, same "not this" symbol as a no-smoking sign.
interface Props {
  heading?: string;
  body?: string;
}

const {
  heading = 'AS SEEN ON: NOWHERE.',
  body = "Never stocked in shops. Never on TV. Never in a newspaper. Never pushed by an influencer. Just made, and worn.",
} = Astro.props;

const items = [
  { label: 'Shops' },
  { label: 'TV' },
  { label: 'Newspapers' },
  { label: 'Influencers' },
];
---
<section class="as-seen-on reveal">
  <div class="aso-inner">
    <h2 class="chunk aso-head">{heading}</h2>
    <p class="aso-body">{body}</p>
    <ul class="aso-icons" aria-hidden="true">
      {items.map((item, i) => (
        <li class="aso-icon" title={item.label} style={`--i:${i}`}>
          {item.label === 'Shops' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M3 9l1.5-5h15L21 9" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M4 9v10a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M9 20v-6h6v6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
          {item.label === 'TV' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <rect x="3" y="6" width="18" height="13" rx="1" />
              <path d="M8 3l4 3 4-3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
          {item.label === 'Newspapers' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <rect x="3" y="5" width="18" height="15" rx="1" />
              <path d="M7 9h6M7 12.5h10M7 16h10" stroke-linecap="round" />
            </svg>
          )}
          {item.label === 'Influencers' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M4 10v4a1 1 0 0 0 1 1h2l4 4V5l-4 4H5a1 1 0 0 0-1 1z" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M17 9a4 4 0 0 1 0 6" stroke-linecap="round" />
            </svg>
          )}
          <span class="aso-slash" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .as-seen-on {
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s4) var(--s3);
    border-bottom: 1px solid var(--line);
    background: var(--panel-2);
    text-align: center;
  }
  .aso-inner { max-width: 640px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: var(--s2); }
  .aso-head { color: var(--ink); font-size: clamp(1.4rem, 3.2vw, 2rem); line-height: 1; }
  .aso-body {
    color: var(--bone-mute); font-family: var(--sans); font-size: 12px;
    letter-spacing: 0.04em; text-transform: uppercase; line-height: 1.6; max-width: 62ch;
  }
  .aso-icons { display: flex; gap: var(--s4); list-style: none; margin-top: var(--s1); }
  .aso-icon { position: relative; width: 28px; height: 28px; color: var(--bone-dim); }
  .aso-icon svg { width: 100%; height: 100%; }
  .aso-slash {
    position: absolute; inset: 0; overflow: hidden;
  }
  .aso-slash::before {
    content: ""; position: absolute; top: 50%; left: -10%; width: 120%; height: 1.5px;
    background: currentColor; transform: rotate(-35deg);
  }
  @media (max-width: 480px) {
    .aso-icons { gap: var(--s3); }
  }

  /* Life: on first scroll into view (reveal.js adds .in) the heading and
     body rise in, each icon pops up in turn, then its strike slashes across
     like a stamp going down. Only ever hidden behind html.js, so no-JS
     visitors see everything at once. */
  html.js .as-seen-on:not(.in) .aso-head,
  html.js .as-seen-on:not(.in) .aso-body { opacity: 0; transform: translateY(14px); }
  html.js .as-seen-on:not(.in) .aso-icon { opacity: 0; transform: translateY(10px) scale(0.8); }
  html.js .as-seen-on:not(.in) .aso-slash::before { transform: rotate(-35deg) scaleX(0); }
  .aso-slash::before { transform-origin: left center; }
  .as-seen-on.in .aso-head { transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .as-seen-on.in .aso-body { transition: opacity 0.5s ease 0.12s, transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) 0.12s; }
  .as-seen-on.in .aso-icon {
    transition:
      opacity 0.35s ease calc(0.3s + var(--i) * 0.12s),
      transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.3s + var(--i) * 0.12s);
  }
  .as-seen-on.in .aso-slash::before {
    transition: transform 0.25s cubic-bezier(0.7, 0, 0.3, 1) calc(0.6s + var(--i) * 0.12s);
  }
  /* After the reveal, the icons and their strikes (both on currentColor)
     keep a slow heartbeat so the band never reads as dead, offset per icon. */
  .as-seen-on.in .aso-icon { animation: aso-breathe 4s ease-in-out calc(1.2s + var(--i) * 0.5s) infinite; }
  @keyframes aso-breathe {
    0%, 100% { color: var(--bone-dim); }
    50% { color: var(--ink); }
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .as-seen-on:not(.in) .aso-head,
    html.js .as-seen-on:not(.in) .aso-body,
    html.js .as-seen-on:not(.in) .aso-icon { opacity: 1; transform: none; }
    html.js .as-seen-on:not(.in) .aso-slash::before { transform: rotate(-35deg); }
    .as-seen-on.in .aso-icon { animation: none; }
  }
</style>
