---
// edit — the inline copy editor.
//
// Shows the real pages in a frame and makes their copy click-to-edit. Every editable
// element carries a data-line-id that ADDRESSES the field in the committed JSON
// (see api/_content.js), so a save is a commit to the repo: no override table, no
// second copy of the copy, and `git revert` undoes anything.
//
// Deliberately not part of the shop's chrome - no masthead, no cart, no footer. It is
// a tool, and it is noindex.
//
// It is served at /edit/ while the shop sits under /new/, so the frame's URLs are
// built from BASE_URL rather than assumed. When the shop moves to the domain root
// that constant changes and nothing here does.
import { products } from '~/lib/catalogue';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// A skinned edition is this same source built under its own base (see
// astro.neo.config.mjs, astro.skeuo.config.mjs), which gives each one this editor
// for free: the page list and the preview frame below are already built from the
// base, so an edition's editor drives that edition's pages. Every editor saves
// through the same /api/edit into the same JSON, so a copy fix lands on ALL of them
// - there is one copy of the copy.
interface Edition { skin: string; room?: string; label: string }
const EDITIONS: Record<string, Edition> = {
  '/neomorphism': { skin: 'neo', label: 'NEOMORPHISM EDITION' },
  '/skeuomorphism': { skin: 'skeuo', label: 'SKEUOMORPHISM EDITION' },
  // The pub edition derives from the skeuomorphic skin, so its editor wears the
  // same chrome; only the label says which site the frame is showing.
  '/pub': { skin: 'skeuo', room: 'pub', label: 'THE SNUG' },
};
const edition: Edition | undefined = EDITIONS[base];

const pages = [
  { label: 'Home', path: '/' },
  { label: 'About', path: '/about' },
  { label: 'The Story', path: '/story' },
  { label: 'Help', path: '/help' },
  { label: 'Contact', path: '/contact' },
  { label: 'The Icons', path: '/icons' },
  { label: 'Link in Bio', path: '/link-in-bio' },
  { label: 'The Collections', path: '/collections/all' },
  ...products.map((p) => ({ label: p.title, path: `/products/${p.handle}` })),
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{edition ? `Copy editor (${edition.room ?? edition.skin}) — BLITZSPIRIT` : 'Copy editor — BLITZSPIRIT'}</title>
    <link rel="icon" type="image/png" href={`${base}/assets/blitzspirit-stamp.png`} />
    <style define:vars={{ fontUrl: `url('${base}/assets/fonts/chunkfive.woff2')` }}>
      @font-face {
        font-family: 'ChunkFive';
        src: var(--fontUrl) format('woff2');
        font-display: swap;
      }
    </style>
  </head>
  <body data-skin={edition?.skin} data-room={edition?.room}>
    <header class="bar">
      <div class="brand">
        <span class="chunk">EDIT</span>
        <span class="tag muted">{edition ? `${edition.label} // COMMITS TO THE REPO` : 'COPY // COMMITS TO THE REPO'}</span>
      </div>

      <label class="picker">
        <span class="visually-hidden">Page</span>
        <select data-page-picker>
          {pages.map((p) => <option value={base + p.path}>{p.label}</option>)}
        </select>
      </label>

      <div class="actions">
        <span class="tag count" data-count>NO CHANGES</span>
        <button type="button" class="btn" data-discard disabled>DISCARD</button>
        <button type="button" class="btn btn--go" data-save disabled>SAVE + PUBLISH</button>
      </div>
    </header>

    <p class="hint tag" data-hint>
      Click any highlighted text to edit it. Enter commits a line, Escape puts it back.
    </p>

    <div class="status" data-status hidden></div>

    <div class="frame-wrap">
      <iframe data-frame title="Site preview" src={base + '/'}></iframe>
    </div>

    <script>
      import '~/scripts/edit-ui.js';
    </script>

    <style>
      :root {
        --ink: #0a0a0a;
        --panel: #111;
        --panel-2: #181818;
        --line: #2a2a2a;
        --line-bri: #3a3a3a;
        --bone: #ececec;
        --bone-dim: #8a8a8a;
        --signal: #f00;
        --mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--ink);
        color: var(--bone);
        font-family: var(--mono);
        display: flex;
        flex-direction: column;
        height: 100vh;
      }
      .chunk { font-family: 'ChunkFive', Georgia, serif; font-size: 20px; letter-spacing: 0.04em; }
      .tag {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }
      .muted { color: var(--bone-dim); }
      .visually-hidden {
        position: absolute; width: 1px; height: 1px; overflow: hidden;
        clip: rect(0 0 0 0); white-space: nowrap;
      }

      .bar {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        padding: 12px 16px;
        background: var(--panel);
        border-bottom: 1px solid var(--line);
      }
      .brand { display: flex; align-items: baseline; gap: 12px; }
      .picker { margin-left: auto; }
      select {
        background: var(--panel-2);
        color: var(--bone);
        border: 1px solid var(--line-bri);
        font-family: var(--mono);
        font-size: 12px;
        padding: 8px 10px;
        min-width: 220px;
      }
      .actions { display: flex; align-items: center; gap: 10px; }
      .count { color: var(--bone-dim); white-space: nowrap; }
      .count[data-dirty] { color: var(--signal); }
      .btn {
        background: transparent;
        color: var(--bone);
        border: 1px solid var(--line-bri);
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        padding: 9px 14px;
        cursor: pointer;
      }
      .btn:hover:not(:disabled) { border-color: var(--bone); }
      .btn:disabled { opacity: 0.4; cursor: default; }
      .btn--go { background: var(--signal); border-color: var(--signal); color: #fff; font-weight: 700; }
      .btn--go:hover:not(:disabled) { background: #fff; border-color: #fff; color: var(--ink); }

      .hint { padding: 8px 16px; color: var(--bone-dim); margin: 0; border-bottom: 1px solid var(--line); }

      .status {
        padding: 10px 16px;
        border-bottom: 1px solid var(--line);
        font-size: 12px;
      }
      .status[data-kind='ok'] { color: #9fe08f; background: #0f1a0d; }
      .status[data-kind='busy'] { color: var(--bone-dim); }
      .status[data-kind='bad'] { color: #fff; background: #3a0d0d; border-bottom-color: var(--signal); }
      .status a { color: inherit; }

      .frame-wrap { flex: 1; min-height: 0; background: var(--ink); }
      iframe { width: 100%; height: 100%; border: 0; display: block; background: var(--ink); }

      @media (max-width: 720px) {
        .picker { margin-left: 0; width: 100%; }
        select { width: 100%; }
        .actions { width: 100%; justify-content: space-between; }
      }

      /* The neomorphic edition's editor wears the edition's skin, so it is obvious
         at a glance which of the two you are about to commit from. Only the chrome
         changes: the frame renders whichever site the base points at, and the save
         path is identical either way. */
      body[data-skin='neo'] {
        --ink: #15171b;
        --panel: #1a1d22;
        --panel-2: #1f2229;
        --line: rgba(255, 255, 255, 0.05);
        --line-bri: rgba(255, 255, 255, 0.1);
        --neo-hi: rgba(255, 255, 255, 0.055);
        --neo-lo: rgba(0, 0, 0, 0.78);
      }
      body[data-skin='neo'] .bar {
        border-bottom: none;
        background: linear-gradient(145deg, #1f2229, #141619);
        box-shadow: 0 10px 26px rgba(0, 0, 0, 0.6);
      }
      body[data-skin='neo'] select,
      body[data-skin='neo'] .btn {
        border: none;
        border-radius: 10px;
        background: linear-gradient(145deg, #1f2229, #141619);
        box-shadow: -3px -3px 7px var(--neo-hi), 4px 4px 10px var(--neo-lo);
        transition: box-shadow 200ms ease, color 200ms ease;
      }
      body[data-skin='neo'] .btn:hover:not(:disabled) { color: #fff; }
      body[data-skin='neo'] .btn:disabled {
        box-shadow: inset 4px 4px 9px var(--neo-lo), inset -3px -3px 7px var(--neo-hi);
      }
      body[data-skin='neo'] .btn--go {
        background: var(--signal);
        color: #fff;
        box-shadow: 0 0 24px rgba(255, 0, 0, 0.32);
      }
      body[data-skin='neo'] .btn--go:hover:not(:disabled) {
        background: #fff;
        color: var(--ink);
        box-shadow: 0 0 26px rgba(255, 255, 255, 0.28);
      }
      body[data-skin='neo'] .hint,
      body[data-skin='neo'] .status { border-bottom: none; }
      body[data-skin='neo'] .frame-wrap { background: var(--ink); }
      @media (prefers-reduced-motion: reduce) {
        body[data-skin='neo'] .btn,
        body[data-skin='neo'] select { transition: none; }
      }

      /* The skeuomorphic edition's editor is the bar's own ledger: oak, brass and
         one enamel button. Same rule as above - only the chrome changes. */
      body[data-skin='skeuo'] {
        --ink: #150d06;
        --panel: #1f1409;
        --panel-2: #2c1d0d;
        --line: #3f2c0c;
        --line-bri: #6a4d15;
        --bone: #f2e8d2;
        --bone-dim: #bfab86;
      }
      body[data-skin='skeuo'] .bar {
        background: linear-gradient(180deg, #2c1d0d 0%, #1f1409 55%, #150d06 100%);
        border-bottom: none;
        box-shadow: 0 3px 0 #3f2c0c, 0 4px 0 #9a7527, 0 12px 24px rgba(0, 0, 0, 0.7);
      }
      body[data-skin='skeuo'] select,
      body[data-skin='skeuo'] .btn {
        border: 1px solid #3f2c0c;
        border-radius: 5px;
        background: linear-gradient(180deg, #3b2d1b 0%, #241a0e 100%);
        box-shadow: inset 0 1px 0 rgba(255, 231, 178, 0.16), 0 2px 0 #150e07,
          0 5px 10px rgba(0, 0, 0, 0.5);
        transition: transform 140ms cubic-bezier(0.3, 0, 0.2, 1), box-shadow 140ms ease,
          color 220ms ease;
      }
      body[data-skin='skeuo'] .btn:hover:not(:disabled) { color: #fff6d8; border-color: #9a7527; }
      body[data-skin='skeuo'] .btn:active:not(:disabled) {
        transform: translateY(2px);
        box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.7);
      }
      body[data-skin='skeuo'] .btn:disabled { box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.7); }
      body[data-skin='skeuo'] .btn--go {
        background: linear-gradient(180deg, #c81f1f 0%, #9e1414 52%, #5d0a0a 100%);
        border-color: #5d0a0a;
        color: #fff3e2;
        box-shadow: inset 0 1px 0 rgba(255, 220, 210, 0.5), 0 3px 0 #4a0808,
          0 8px 18px rgba(0, 0, 0, 0.6);
      }
      body[data-skin='skeuo'] .btn--go:hover:not(:disabled) {
        background: linear-gradient(180deg, #d92727 0%, #ab1616 52%, #660b0b 100%);
        border-color: #660b0b;
        color: #fff;
      }
      body[data-skin='skeuo'] .hint { border-bottom-color: #3f2c0c; }
      body[data-skin='skeuo'] .status { border-bottom-color: #3f2c0c; }
      body[data-skin='skeuo'] .frame-wrap,
      body[data-skin='skeuo'] iframe { background: var(--ink); }
      @media (prefers-reduced-motion: reduce) {
        body[data-skin='skeuo'] .btn,
        body[data-skin='skeuo'] select { transition: none; }
      }
    </style>
  </body>
</html>
