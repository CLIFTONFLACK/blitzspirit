---
// social - the internal copy dossier: hooks, captions and CTAs for IG and TikTok.
//
// Not part of the shop. It carries no masthead, cart or footer on purpose: it is a
// working tool for whoever is writing posts, and the shop chrome would only get in
// the way. It is noindex, and excluded from the sitemap in astro.config.mjs.
//
// Copy lives in src/data/pages/social.json and is rendered server-side, so the page
// is complete and readable before any script runs. Edits are overlaid on top: the
// browser fetches /api/social, swaps in any line that has been changed, and posts
// changes back. The JSON in the repo stays the canonical version - an override can
// always be reverted to it.
import '~/styles/tokens.css';
import page from '~/data/pages/social.json';

// TypeScript infers a union of every literal shape in the JSON, which makes the
// optional fields unreachable. These are the shapes the file actually has.
interface Variant {
  id: string;
  reg: 'house' | 'eased' | 'locked' | string;
  label: string;
  text: string;
  dir?: string;
  tag?: { text: string; warn: boolean };
}
interface Entry { ref: string; variants: Variant[] }
interface Group { heading: string; note: string; entries: Entry[] }
interface Part { role: string | null; entry: Entry }
interface Section { id: string; kind: string; eyebrow: string; heading: string; groups: Group[] }
interface Reference {
  id: string;
  eyebrow: string;
  heading: string;
  table?: { columns: string[]; rows: string[][] };
  open?: { heading: string; body: string };
  items?: { title: string; body: string }[];
}

const intro = page.intro;
const sections = page.sections as Section[];
const reference = page.reference as Reference[];
const editable = sections.flatMap((s) => s.groups.flatMap((g) => g.entries.flatMap((e) => e.variants)));

// The chips are named for where the copy comes from, not for the shape of it:
// what is locked to the Brand Book, what was written beyond it, and Dravot, who
// has his own voice and never sells a shirt. Hooks, captions and CTAs sit in one
// group because they are used together - a hook needs its caption and its ask.
// Every entry, addressable by its ref: a set names its parts, it does not copy them,
// so each line is still written in exactly one place.
const byRef: Map<string, Entry> = new Map(
  sections.flatMap((s) => s.groups.flatMap((g) => g.entries.map((e) => [e.ref, e] as [string, Entry]))),
);

/** A set is what actually gets posted. In Beyond Brand Book that is the hook, its
 *  caption and its ask; in From Brand Book, a locked line, the product copy it hangs
 *  on and the state line that closes it; for Dravot, an opening, a line and the only
 *  ask his register allows. Nothing appears in two sets - the parts are one to one. */
interface RawPart { role: string; ref: string }
interface RawSet { ref: string; parts: RawPart[] }
interface View {
  id: string;
  kind: string;
  eyebrow: string;
  heading: string;
  groups: { heading: string; note: string; sets: RawSet[] }[];
}

const views = ((page as any).views as View[]).map((v) => ({
  ...v,
  groups: v.groups.map((g) => ({
    ...g,
    sets: g.sets.map((set) => ({
      ref: set.ref,
      parts: set.parts.map((part) => ({ role: part.role, entry: byRef.get(part.ref)! })),
    })),
  })),
}));

const setCount = views.reduce((n, v) => n + v.groups.reduce((m, g) => m + g.sets.length, 0), 0);

const filters = [
  { label: 'All', kinds: [] },
  { label: 'From Brand Book', kinds: ['brandbook'] },
  { label: 'Beyond Brand Book', kinds: ['beyond'] },
  { label: 'Dravot says', kinds: ['dravot'] },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Social copy - BlitzSpirit</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&display=swap"
    />
    <link rel="icon" type="image/png" href="/assets/blitzspirit-stamp.png" />
  </head>

  <body>
    <div class="band">{intro.band}</div>

    <div class="wrap">
      <header class="mast">
        <a class="home" href="/">← blitzspirit</a>
        <p class="eyebrow">{intro.eyebrow}</p>
        <h1 class="chunk">{intro.heading}</h1>
      </header>


      <div class="controls" role="search">
        <div class="chipset" id="kinds">
          <span class="setlabel">Show</span>
          {filters.map((f, i) => (
            <button
              class="chip"
              type="button"
              data-filter={f.kinds.join(',') || 'all'}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {f.label}
            </button>
          ))}
        </div>


        <input class="search" id="search" type="search" placeholder="Search" aria-label="Search every line" />

        <span class="count" id="count">{setCount} entries</span>

        <div class="editbar">
          <button class="chip edit" type="button" id="editToggle" aria-pressed="false">Edit</button>
          <button class="chip save" type="button" id="save" hidden>Save</button>
          <span class="status" id="status" role="status" aria-live="polite"></span>
        </div>
      </div>

      {views.map((section) => (
        <section id={section.id} data-kind={section.kind}>
          <p class="eyebrow">{section.eyebrow}</p>
          <h2 class="chunk">{section.heading}</h2>

          {section.groups.map((group) => (
            <>
              <div class="grouphead">
                <h3>{group.heading}</h3>
                <span class="note">{group.note}</span>
              </div>
              <div class="lines">
                {group.sets.map((set, i) => (
                  <div class={'line' + (set.parts.length > 1 ? ' set' : '') + (set.parts[0].entry.variants[0].reg === 'locked' ? ' locked' : '')}>
                    <div class="sethead">
                      <span class="num">{String(i + 1).padStart(2, '0')}</span>
                      <span class="setref">{set.ref}</span>
                    </div>
                    {set.parts.map((part) => (
                      <div class="part">
                        <div class="partmeta">
                          {part.role && <span class="role">{part.role}</span>}
                          <span class="ref">{part.entry.ref}</span>
                        </div>
                        <div class="vars">
                          {part.entry.variants.map((v) => (
                            <div class="v" data-reg={v.reg}>
                              <span class="vlabel">{v.label}</span>
                              <div class="body">
                                <p class="txt" data-line-id={v.id} data-seed={v.text}>{v.text}</p>
                                {v.tag && <span class={'tag' + (v.tag.warn ? ' warn' : '')}>{v.tag.text}</span>}
                                {v.dir && <span class="dir">{v.dir}</span>}
                                <span class="editflag" hidden>
                                  Edited · <button class="revert" type="button" data-revert={v.id}>Revert</button>
                                </span>
                              </div>
                              <button class="copy" type="button">Copy</button>
                            </div>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                ))}
              </div>
            </>
          ))}
        </section>
      ))}

      {reference.map((ref) => (
        <section id={ref.id} class="reference">
          <p class="eyebrow">{ref.eyebrow}</p>
          <h2 class="chunk">{ref.heading}</h2>

          {ref.table && (
            <div class="tablewrap">
              <table>
                <thead>
                  <tr>{ref.table.columns.map((c) => <th scope="col">{c}</th>)}</tr>
                </thead>
                <tbody>
                  {ref.table.rows.map((row) => (
                    <tr>
                      {row.map((cell, i) => (
                        <td>{i === 0 ? <span class="prod">{cell}</span> : i > 1 ? <code>{cell}</code> : cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {ref.open && (
            <div class="open">
              <b>{ref.open.heading}</b>
              <span>{ref.open.body}</span>
            </div>
          )}

          {ref.items && (
            <div class="guard">
              <ul>
                {ref.items.map((item) => (
                  <li><b>{item.title}</b><span>{item.body}</span></li>
                ))}
              </ul>
            </div>
          )}
        </section>
      ))}

      <footer>
        <span>Blitzspirit - copy dossier, Issue 002</span>
        <span>Governed by Brand Book v4.0</span>
        <span>Built for the stubborn</span>
      </footer>
    </div>

    <script>
      import '~/scripts/social.js';
    </script>

    <style>
      :root {
        /* The dossier reads as a document, not as shop chrome: Montserrat for
           everything except the ChunkFive headings, which are the brand's own face. */
        --page-font: 'Montserrat', system-ui, -apple-system, 'Segoe UI', sans-serif;
        --khaki: #B89B5E;
        --hair: rgba(184, 155, 94, 0.28);
        --hair-hi: rgba(184, 155, 94, 0.7);
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--ink);
        color: var(--bone);
        font-family: var(--page-font);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .wrap { max-width: 1140px; margin: 0 auto; padding: 0 var(--s3) var(--s7); }

      a { color: var(--bone); }
      ::selection { background: var(--signal); color: #fff; }
      :focus-visible { outline: 2px solid var(--khaki); outline-offset: 2px; }

      .band {
        background: var(--signal);
        color: #fff;
        font-size: 13px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        text-align: center;
        padding: 9px var(--s2);
      }

      .mast { padding: var(--s5) 0 var(--s4); border-bottom: 1px solid var(--line); }
      .home {
        display: inline-block;
        font-size: 13px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #fff;
        text-decoration: none;
        margin-bottom: var(--s4);
      }
      .home:hover { color: var(--bone); }

      .chunk {
        font-family: var(--display-font);
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: -0.01em;
        line-height: 0.95;
        margin: 0;
      }
      h1.chunk { font-size: clamp(36px, 6.4vw, 70px); max-width: 18ch; }
      h2.chunk { font-size: clamp(26px, 3.4vw, 40px); }

      .eyebrow {
        font-size: 13px;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--khaki);
        margin: 0 0 var(--s1);
      }




      section { padding-top: var(--s6); scroll-margin-top: 110px; }

      h3 {
        font-family: var(--display-font);
        font-weight: 400; text-transform: uppercase; letter-spacing: 0.01em;
        font-size: 22px; margin: 0;
      }
      .grouphead {
        display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap;
        margin: var(--s4) 0 var(--s2);
        padding-bottom: var(--s1);
        border-bottom: 1px solid var(--line);
      }
      .grouphead .note { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: #fff; }

      /* ---- controls ---- */
      .controls {
        position: sticky; top: 0; z-index: 20;
        background: var(--ink);
        border-bottom: 1px solid var(--line);
        padding: 12px 0 10px;
        margin-top: var(--s4);
        display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: center;
      }
      .chipset { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
      .setlabel { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: #fff; margin-right: 4px; }
      .chip {
        font-family: var(--page-font);
        font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase;
        color: #fff; background: transparent;
        border: 1px solid var(--line); padding: 9px 11px; min-height: 38px;
        cursor: pointer; transition: color .18s, border-color .18s, background-color .18s;
      }
      .chip:hover { color: var(--bone); border-color: var(--line-bri); }
      .chip[aria-pressed='true'] { background: var(--signal); border-color: var(--signal); color: #fff; }

      .search {
        flex: 1 1 170px; min-width: 150px;
        font-family: var(--page-font); font-size: 14px; letter-spacing: 0.08em;
        color: var(--bone); background: var(--panel);
        border: 1px solid var(--line); padding: 10px 12px; min-height: 38px;
      }
      .search::placeholder { color: #fff; text-transform: uppercase; letter-spacing: 0.16em; font-size: 13px; }

      .count { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--khaki); white-space: nowrap; }

      .editbar { display: flex; align-items: center; gap: 8px; margin-left: auto; }
      .chip.edit[aria-pressed='true'] { background: var(--khaki); border-color: var(--khaki); color: #000; }
      .chip.save { border-color: var(--signal); color: var(--signal); }
      .chip.save:hover { background: var(--signal); color: #fff; }
      .status { font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; }
      .status[data-tone='ok'] { color: var(--khaki); }
      .status[data-tone='bad'] { color: var(--signal); }

      /* ---- entries ---- */
      .lines { display: flex; flex-direction: column; gap: var(--s4); }

      /* One set is one postable thing: hook, caption, ask. The page is dark; the
         parts are printed cards - white, dark text - stacked with air between them
         so each reads as its own card, under one number for the set. */
      .line {
        display: flex; flex-direction: column; gap: 10px;
        background: transparent; border: 0; padding: 0;
      }
      .sethead {
        display: flex; align-items: baseline; gap: 12px;
        padding: 0 2px;
      }
      .num {
        font-family: var(--display-font); font-size: 26px; line-height: 1;
        color: var(--khaki); font-variant-numeric: tabular-nums;
      }
      .setref { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: #fff; }

      .part {
        --card-ink: #0D0C0A;
        --card-mute: #5C5548;
        --card-red: #B01E14;
        --card-gold: #7A6230;
        --card-hair: rgba(13, 12, 10, 0.14);
        background: #fff; color: var(--card-ink);
        border-left: 4px solid var(--card-gold);
        padding: 14px 18px 16px;
        transition: box-shadow .18s;
      }
      .part:hover { box-shadow: 0 0 0 1px var(--khaki); }
      .line.set .sethead + .part { border-left-color: var(--card-red); }
      .line.locked .sethead + .part { border-left-color: var(--khaki); }

      .partmeta { display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px; }
      .role {
        font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
        color: var(--card-red); font-weight: 600;
      }
      .line.set .part ~ .part .role { color: var(--card-gold); }
      .partmeta .ref { font-size: 12px; letter-spacing: 0.1em; color: var(--card-mute); font-variant-numeric: tabular-nums; }

      .vars { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
      .v {
        display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; align-items: start;
        padding: 8px 0;
      }
      .v + .v { border-top: 1px dashed var(--card-hair); }
      .v .body { grid-column: 1; }
      .v .copy { grid-column: 2; grid-row: 1 / 3; align-self: start; }

      .vlabel { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 600; white-space: nowrap; }
      .v[data-reg='house'] .vlabel { color: var(--card-red); }
      .v[data-reg='eased'] .vlabel { color: var(--card-mute); }
      .v[data-reg='locked'] .vlabel { color: var(--card-gold); }

      .body { min-width: 0; }
      .txt {
        margin: 0; font-size: 18px; line-height: 1.45; white-space: pre-line;
        max-width: 66ch; letter-spacing: 0.01em; color: var(--card-ink);
      }

      .dir, .editflag {
        display: block; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--card-mute); margin-top: 7px;
      }
      .editflag { color: var(--card-gold); }
      /* A class selector outranks the browser's own [hidden] rule, so display:block
         above would keep the flag on every line whether it has been edited or not. */
      [hidden] { display: none !important; }
      .revert {
        font-family: var(--page-font); font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase;
        background: none; border: 0; border-bottom: 1px solid var(--card-gold);
        color: var(--card-gold); padding: 0; cursor: pointer;
      }
      .revert:hover { color: var(--card-ink); }

      .copy {
        font-family: var(--page-font); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase;
        color: var(--card-ink); background: transparent; border: 1px solid var(--card-ink);
        padding: 0 10px; height: 30px; min-width: 64px; cursor: pointer;
        transition: color .15s, background-color .15s, border-color .15s;
      }
      .copy:hover { background: var(--card-ink); color: #fff; }
      .copy.done { color: #fff; background: var(--card-red); border-color: var(--card-red); }

      .tag {
        display: inline-block; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--card-mute); border: 1px solid var(--card-hair); padding: 2px 6px; margin-top: 7px;
      }
      .tag.warn { color: var(--card-red); border-color: rgba(176, 30, 20, 0.5); }

      /* editing state */
      body[data-edit='on'] .txt {
        outline: 1px dashed var(--card-gold); outline-offset: 4px; cursor: text;
      }
      body[data-edit='on'] .txt:focus { outline: 1px solid var(--card-gold); background: #FFF7E3; }
      .txt[data-edited='1'] { border-left: 2px solid var(--card-gold); padding-left: 10px; margin-left: -12px; }

      /* ---- reference ---- */
      .tablewrap { overflow-x: auto; border: 1px solid var(--line); margin-top: var(--s3); }
      table { border-collapse: collapse; width: 100%; min-width: 720px; font-size: 15px; }
      th, td { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
      thead th {
        font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase;
        color: var(--khaki); background: var(--panel-2); white-space: nowrap;
      }
      tbody tr { background: var(--panel); }
      tbody tr:last-child td { border-bottom: 0; }
      td .prod { font-family: var(--display-font); text-transform: uppercase; font-size: 17px; white-space: nowrap; }
      td code { font-family: var(--page-font); font-size: 14px; color: var(--khaki); white-space: nowrap; }

      .open {
        border: 1px solid rgba(255, 0, 0, 0.4); background: var(--panel);
        padding: var(--s2); margin-top: var(--s3); max-width: 82ch; font-size: 15px; color: #fff;
      }
      .open b { display: block; font-family: var(--display-font); text-transform: uppercase; color: var(--bone); font-size: 17px; margin-bottom: 6px; }

      .guard {
        border: 1px solid rgba(255, 0, 0, 0.4); background: var(--panel);
        padding: var(--s3); margin-top: var(--s3);
      }
      .guard ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; }
      .guard li { padding-left: 20px; position: relative; max-width: 80ch; }
      .guard li::before { content: '-'; position: absolute; left: 0; color: var(--signal); }
      .guard li b { display: block; font-family: var(--display-font); text-transform: uppercase; font-size: 17px; }
      .guard li span { color: #fff; font-size: 15px; }

      footer {
        margin-top: var(--s7); padding-top: var(--s3); border-top: 1px solid var(--line);
        display: flex; flex-wrap: wrap; gap: 8px 24px;
        font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; color: #fff;
      }

      @media (max-width: 700px) {
        .part { padding: 12px 14px 14px; }
        .v { grid-template-columns: 1fr; }
        .v .copy { grid-column: 1; grid-row: auto; justify-self: start; }
        .editbar { margin-left: 0; }
      }

      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; }
      }
    </style>
  </body>
</html>
