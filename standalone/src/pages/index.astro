---
// Home — templates/index.json, section for section and in order:
// hero, as-seen-on, product grid (all 3, one row), promo, promo_band_VF78L7.
//
// The featured-product band and the alternating archive rows were replaced
// by one 3-up grid (CollectionGrid, the same one collection pages use) —
// with only 3 products left in the catalogue, showing them all in a single
// row above the promo band reads better than a tall stack of full-width
// rows. `featured`/`archive` settings in pages/index.json are unused now;
// left in place rather than edited, since /edit still addresses them.
import Base from '~/layouts/Base.astro';
import Hero from '~/components/Hero.astro';
import AsSeenOn from '~/components/AsSeenOn.astro';
import CollectionGrid from '~/components/CollectionGrid.astro';
import PromoBand from '~/components/PromoBand.astro';
import AboutSplit from '~/components/AboutSplit.astro';

import pageData from '~/data/pages/index.json';
import { settings, type PageData } from '~/lib/pages';
import { products } from '~/lib/catalogue';

const page = pageData as PageData;

const hero = settings(page, 'hero');
const promo = settings(page, 'promo');
const promo2 = settings(page, 'promo_band_VF78L7');

const meansHeading = 'What it means.';
const meansBody = '<p>The blitz spirit isn’t nostalgia. It’s not bunting and Churchill quotes on a tea towel. It’s a specific quality: the ability to be <em>cheerful in adversity</em>, practical under pressure, and fundamentally unimpressed by things that are trying very hard to impress you.</p><p>It shows up in a skull wearing a bowler hat. In a mod target built from a single word. In a typographic roll call that’s set like a setlist because the names deserve the stage. <em>That’s what we make. That’s why it works.</em></p>';
---
<Base
  title="BLITZSPIRIT"
  description="Ironic. Iconic. Made in Britain. Heavyweight tees and equipment with a backbone story — ISSUE_001."
>
  <Hero heading={hero.heading} editBase="pages/index:hero" />

  <AsSeenOn />

  <CollectionGrid products={products} />

  <PromoBand
    id="PromoBand"
    image={promo.image}
    heading={promo.heading}
    subheading={promo.subheading}
    leadLine={promo.lead_line}
    placeholder={promo.placeholder}
    buttonLabel={promo.button_label}
    successText={promo.success_text}
    editBase="pages/index:promo"
  />

  <AboutSplit
    heading={meansHeading}
    body={meansBody}
    image="/assets/backgrounds/skull-umbrella-crop.jpg"
    imageSide="left"
    fillVisual
  />

  <PromoBand
    id="PromoBandEarlyBirds"
    image={promo2.image}
    heading={promo2.heading}
    subheading={promo2.subheading}
    leadLine={promo2.lead_line}
    placeholder={promo2.placeholder}
    buttonLabel={promo2.button_label}
    successText={promo2.success_text}
    editBase="pages/index:promo_band_VF78L7"
  />
</Base>
