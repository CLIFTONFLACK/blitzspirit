---
// Home — templates/index.json, section for section and in order:
// hero, as-seen-on, featured product, statement band, product grid (all 3, one
// row), promo (signup), what-it-means.
//
// One email ask only: the statement band (promo_band_VF78L7, "The Blitz, the
// weather, the pub queue.") renders without its signup form, because with the
// promo band below and the signup modal a second form made three asks against
// one product row.
//
// The featured band (The Establishment, from pages/index.json `featured`) leads,
// the statement band follows it, then the grid of the whole range. The
// alternating archive rows stay replaced by the grid: `archive` settings in
// pages/index.json are unused, left in place since /edit still addresses them.
//
// At ≤860px, where the 3-up row would otherwise wrap, the grid becomes a
// one-row swipe carousel that also auto-advances (CollectionGrid `carousel`).
import Base from '~/layouts/Base.astro';
import Hero from '~/components/Hero.astro';
import AsSeenOn from '~/components/AsSeenOn.astro';
import CollectionGrid from '~/components/CollectionGrid.astro';
import FeaturedProduct from '~/components/FeaturedProduct.astro';
import PromoBand from '~/components/PromoBand.astro';
import StubbornStrip from '~/components/StubbornStrip.astro';
import AboutSplit from '~/components/AboutSplit.astro';

import pageData from '~/data/pages/index.json';
import { settings, type PageData } from '~/lib/pages';
import { products } from '~/lib/catalogue';

const page = pageData as PageData;

const hero = settings(page, 'hero');
const featured = settings(page, 'featured');
const promo = settings(page, 'promo');
const promo2 = settings(page, 'promo_band_VF78L7');

const meansHeading = 'What it means.';
const meansBody = '<p>The blitz spirit isn’t nostalgia. It’s not bunting and Churchill quotes on a tea towel.</p><p>It’s a specific quality: the ability to be <em>cheerful in adversity</em>, practical under pressure, and fundamentally unimpressed by things that are trying very hard to impress you.</p>';
---
<Base
  title="BLITZSPIRIT"
  description="Ironic. Iconic. Printed in Britain. T-shirts with a backbone story — ISSUE_001."
>
  <Hero heading={hero.heading} editBase="pages/index:hero" />

  <AsSeenOn />

  <FeaturedProduct
    product={featured.product}
    dossier={featured.dossier}
    whatLabel={featured.what_label}
    plateRef={featured.plate_ref}
    editBase="pages/index:featured"
  />

  <PromoBand
    id="PromoBandStatement"
    image={promo2.image}
    heading={promo2.heading}
    subheading={promo2.subheading}
    showForm={false}
    editBase="pages/index:promo_band_VF78L7"
  />

  <CollectionGrid products={products} wide carousel />

  <PromoBand
    id="PromoBand"
    image={promo.image}
    heading={promo.heading}
    subheading={promo.subheading}
    leadLine={promo.lead_line}
    placeholder={promo.placeholder}
    buttonLabel={promo.button_label}
    successText={promo.success_text}
    editBase="pages/index:promo"
  />

  <AboutSplit
    heading={meansHeading}
    body={meansBody}
    image="/assets/backgrounds/skull-umbrella-banner.jpg"
    imageSide="left"
    fillVisual
  />

  <StubbornStrip heading={hero.heading} />
</Base>
