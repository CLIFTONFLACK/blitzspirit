---
// About — templates/page.about.json: hero, split-started, split-make, values,
// split-means, newsletter.
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import AboutSplit from '~/components/AboutSplit.astro';
import ValuesGrid from '~/components/ValuesGrid.astro';
import Newsletter from '~/components/Newsletter.astro';

import pageData from '~/data/pages/about.json';
import { settings, blocks, type PageData } from '~/lib/pages';

const page = pageData as PageData;
const hero = settings(page, 'hero');
const started = settings(page, 'split-started');
const make = settings(page, 'split-make');
const means = settings(page, 'split-means');
const news = settings(page, 'newsletter');

const split = (s: Record<string, any>) => ({
  indexTag: s.index_tag,
  heading: s.heading,
  body: s.body,
  imageRef: s.image_ref,
  imageSide: s.image_side,
  ctaLabel: s.cta_label,
  ctaLink: s.cta_link,
});
---
<Base
  title={page.title ?? 'About'}
  description="London, 2008. A bowler hat, a skull, two crossed umbrellas — and a question about what British stoicism looks like on a t-shirt."
>
  <PageHero
    indexTag={hero.index_tag}
    showPageRef={hero.show_page_ref}
    pageTitle={page.title}
    heading={hero.heading}
    redFirstLine={hero.red_first_line}
    headingSize={hero.heading_size}
    extraHeight={hero.extra_height}
    blocks={blocks(page, 'hero')}
  />
  <AboutSplit {...split(started)} />
  <AboutSplit {...split(make)} />
  <ValuesGrid blocks={blocks(page, 'values')} />
  <AboutSplit {...split(means)} />
  <Newsletter
    sectionId="about"
    indexTag={news.index_tag}
    heading={news.heading}
    body={news.body}
    buttonLabel={news.button_label}
  />
</Base>
