# Stripe — test keys until the shop is verified end to end.
STRIPE_SECRET_KEY=sk_test_...

# Where Stripe returns the shopper after checkout. Optional: defaults to the
# request origin, which is correct on Vercel preview and production alike.
PUBLIC_SITE_URL=http://localhost:4321

# Resend, for the newsletter form. Without both of these /api/newsletter returns
# 501 and the form shows its error state rather than pretending to have stored
# the address.
RESEND_API_KEY=re_...
RESEND_AUDIENCE_ID=

# Printful private token (Printful dashboard > Settings > API). Used by
# /api/stripe-webhook to create orders, and by `npm run printful:sync` to copy
# prices and variant ids into the catalogue.
PRINTFUL_API_TOKEN=

# Signing secret of the Stripe webhook endpoint pointed at /api/stripe-webhook
# (event: checkout.session.completed). Deliveries without a valid signature get 400.
STRIPE_WEBHOOK_SECRET=whsec_...

# "true" sends paid orders straight into Printful production and bills the Printful
# account. Anything else leaves them as drafts to confirm by hand.
PRINTFUL_CONFIRM_ORDERS=false

# Where to email when a paid order cannot reach Printful and retrying won't help.
# Sent through Resend (RESEND_API_KEY above). Without it the failure is only logged.
# ORDER_ALERT_FROM defaults to Resend's onboarding sender, which only delivers to the
# Resend account owner's own address; set it once blitzspirit.co.uk is verified.
ORDER_ALERT_EMAIL=
ORDER_ALERT_FROM=
